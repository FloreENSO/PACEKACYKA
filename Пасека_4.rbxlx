			<Properties>
				<ProtectedString name="Source"><![CDATA[local Terrain = workspace.Terrain
local rng, C3 = Random.new(), Color3.fromRGB

-- ========== НАСТРОЙКИ ==========
local FLOOR_R = 330          -- радиус пола
local FLOOR_TOP = 0.1        -- высота пола (ниже площади, дорожек и газона)
local MOUNT_R = 270          -- радиус кольца гор
local WALL_R = 208           -- радиус невидимой стены (дальше игроки не пройдут)
local STEP = 32              -- расстояние между горами (меньше = гуще)
local MIN_H, MAX_H = 85, 150 -- высота гор

local world = Instance.new("Folder")
world.Name, world.Parent = "World", workspace

-- ========== ПОЛ ==========
local floor = Instance.new("Part")
floor.Name, floor.Shape, floor.Anchored = "Floor", Enum.PartType.Cylinder, true
floor.Size = Vector3.new(1, FLOOR_R * 2, FLOOR_R * 2)
floor.CFrame = CFrame.new(0, FLOOR_TOP - 0.5, 0) * CFrame.Angles(0, 0, math.pi / 2)
floor.Color, floor.Material = C3(78, 146, 60), Enum.Material.Grass
floor.TopSurface, floor.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
floor.Parent = world

-- ========== ГОРЫ (удалены: каменные шары и невидимые стены мешали подъёму) ==========
-- Горы теперь — полностью проходимый травяной рельеф террейна, сгенерированный в месте
Terrain:SetMaterialColor(Enum.Material.Grass, C3(88, 160, 66))
Terrain:SetMaterialColor(Enum.Material.Snow, C3(244, 248, 255))]]></ProtectedString>

		<Item class="Script" referent="RBXA0DC238434D24F8C92F229652476CBAE">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local W = workspace

local HIVE_PRICE = 1500
local MAX_HIVES = 8

local openEvent = Instance.new("RemoteEvent")
openEvent.Name = "OpenAndreyShop"
openEvent.Parent = RS

local buyHiveFn = Instance.new("RemoteFunction")
buyHiveFn.Name = "BuyHive"
buyHiveFn.Parent = RS

local function setupPlayer(plr)
	if not plr:FindFirstChild("Hives") then
		local hives = Instance.new("Folder")
		hives.Name = "Hives"
		hives.Parent = plr
	end
end
Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end

task.spawn(function()
	local hub = W:WaitForChild("Hub")
	local shopIvan = hub:WaitForChild("BeekeeperShop")
	task.wait(1)

	local ivanCounter = shopIvan:FindFirstChild("CounterTop")
	local basePos = ivanCounter and ivanCounter.Position or Vector3.new(0, 0, 0)
	local andreyPos = Vector3.new(basePos.X - 45, 0.1, basePos.Z + 10)

	local andreyShop = Instance.new("Model")
	andreyShop.Name = "AndreyWorkshop"
	andreyShop.Parent = hub

	local function makePart(name, size, cf, color, mat, parent, shape, variant)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color, p.Material = name, size, cf, color, mat
		p.Anchored = true
		if shape then p.Shape = shape end
		if variant then p.MaterialVariant = variant end
		p.Parent = parent
		return p
	end

	-- Каменный фундамент и дорожка (булыжник)
	makePart("Foundation", Vector3.new(18, 0.4, 16), CFrame.new(andreyPos + Vector3.new(0, -0.35, 0)), Color3.fromRGB(120, 115, 110), Enum.Material.Cobblestone, andreyShop, nil, "andrey-workshop-cobblestone")
	makePart("Path", Vector3.new(4, 0.4, 10), CFrame.new(andreyPos + Vector3.new(0, -0.35, -12)), Color3.fromRGB(120, 115, 110), Enum.Material.Cobblestone, andreyShop, nil, "andrey-workshop-cobblestone")

	-- ========== ПОСТРОЙКА ==========
	makePart("Floor", Vector3.new(16, 0.5, 14), CFrame.new(andreyPos), Color3.fromRGB(100, 70, 40), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")
	makePart("Step", Vector3.new(10, 0.5, 2), CFrame.new(andreyPos + Vector3.new(0, -0.2, -7)), Color3.fromRGB(80, 55, 30), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")

	-- Задняя стена
	makePart("BackWallBottom", Vector3.new(16, 4, 0.5), CFrame.new(andreyPos + Vector3.new(0, 2, 7)), Color3.fromRGB(139, 94, 60), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")
	makePart("BackWallTop", Vector3.new(16, 2, 0.5), CFrame.new(andreyPos + Vector3.new(0, 7, 7)), Color3.fromRGB(139, 94, 60), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")
	makePart("BackWallLeft", Vector3.new(5, 2, 0.5), CFrame.new(andreyPos + Vector3.new(-5.5, 5, 7)), Color3.fromRGB(139, 94, 60), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")
	makePart("BackWallRight", Vector3.new(5, 2, 0.5), CFrame.new(andreyPos + Vector3.new(5.5, 5, 7)), Color3.fromRGB(139, 94, 60), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")

	-- Боковые стены
	makePart("LeftWall", Vector3.new(0.5, 8, 14), CFrame.new(andreyPos + Vector3.new(-8, 4, 0)), Color3.fromRGB(139, 94, 60), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")
	makePart("RightWall", Vector3.new(0.5, 8, 14), CFrame.new(andreyPos + Vector3.new(8, 4, 0)), Color3.fromRGB(139, 94, 60), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")

	-- Окно
	local glass = makePart("WindowGlass", Vector3.new(6, 3, 0.1), CFrame.new(andreyPos + Vector3.new(0, 5, 7)), Color3.fromRGB(150, 200, 255), Enum.Material.Glass, andreyShop)
	glass.Transparency = 0.5
	makePart("ShutterLeft", Vector3.new(3, 3.2, 0.3), CFrame.new(andreyPos + Vector3.new(-4.5, 5, 6.7)) * CFrame.Angles(0, math.rad(30), 0), Color3.fromRGB(110, 70, 40), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")
	makePart("ShutterRight", Vector3.new(3, 3.2, 0.3), CFrame.new(andreyPos + Vector3.new(4.5, 5, 6.7)) * CFrame.Angles(0, math.rad(-30), 0), Color3.fromRGB(110, 70, 40), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")

	-- Балки
	makePart("Beam", Vector3.new(0.8, 9, 0.8), CFrame.new(andreyPos + Vector3.new(-7.5, 4.5, 6.5)), Color3.fromRGB(80, 50, 30), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")
	makePart("Beam", Vector3.new(0.8, 9, 0.8), CFrame.new(andreyPos + Vector3.new(7.5, 4.5, 6.5)), Color3.fromRGB(80, 50, 30), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")

	-- Крыша (черепица)
	local roofBase = makePart("RoofBase", Vector3.new(18, 1, 16), CFrame.new(andreyPos + Vector3.new(0, 9, 0)), Color3.fromRGB(160, 70, 40), Enum.Material.RoofShingles, andreyShop, nil, "andrey-workshop-roof-shingles")
	roofBase.CFrame = roofBase.CFrame * CFrame.Angles(0, 0, math.rad(10))

	-- ВЫВЕСКА (смотрит ровно на игрока)
	local sign = makePart("Sign", Vector3.new(10, 2, 0.2), CFrame.new(andreyPos + Vector3.new(0, 8, -8)), Color3.fromRGB(255, 220, 100), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.Parent = sign
	local st = Instance.new("TextLabel")
	st.Size = UDim2.fromScale(1, 1); st.BackgroundTransparency = 1
	st.Text = "МАСТЕРСКАЯ"; st.TextScaled = true
	st.Font = Enum.Font.GothamBold; st.TextColor3 = Color3.fromRGB(60, 35, 15)
	st.Parent = sg

	-- ПРИЛАВОК
	local counter = makePart("Counter", Vector3.new(10, 3.5, 2.5), CFrame.new(andreyPos + Vector3.new(0, 1.75, -3.5)), Color3.fromRGB(120, 80, 50), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")
	local top = makePart("CounterTop", Vector3.new(10.5, 0.4, 3), CFrame.new(andreyPos + Vector3.new(0, 3.7, -3.5)), Color3.fromRGB(90, 60, 35), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")
	makePart("Shelf1", Vector3.new(9.5, 0.2, 2), CFrame.new(andreyPos + Vector3.new(0, 1.5, -3.5)), Color3.fromRGB(80, 50, 30), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")
	makePart("Shelf2", Vector3.new(9.5, 0.2, 2), CFrame.new(andreyPos + Vector3.new(0, 2.5, -3.5)), Color3.fromRGB(80, 50, 30), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")

	-- ДЕКОР (Бочки, бревна, верстак)
	for i = 1, 3 do
		makePart("Barrel", Vector3.new(2, 3, 2), CFrame.new(andreyPos + Vector3.new(6, 1.5, 5 + (i*0.2))), Color3.fromRGB(130, 90, 60), Enum.Material.Wood, andreyShop, Enum.PartType.Cylinder, "andrey-workshop-oak-beams")
	end
	for i = 1, 4 do
		makePart("Log", Vector3.new(8, 1, 1.2), CFrame.new(andreyPos + Vector3.new(-4, 1 + (i * 1.2), 6)), Color3.fromRGB(100, 70, 40), Enum.Material.Wood, andreyShop, Enum.PartType.Cylinder, "andrey-workshop-oak-beams")
	end
	makePart("Workbench", Vector3.new(6, 1, 3), CFrame.new(andreyPos + Vector3.new(-4, 3, 4)), Color3.fromRGB(90, 60, 35), Enum.Material.Wood, andreyShop, nil, "andrey-workshop-oak-beams")
	makePart("HalfHive", Vector3.new(2.5, 2, 2.5), CFrame.new(andreyPos + Vector3.new(-4, 4.5, 4)), Color3.fromRGB(220, 145, 45), Enum.Material.WoodPlanks, andreyShop, nil, "andrey-workshop-floor-planks")

	local pole = makePart("Pole", Vector3.new(0.5, 10, 0.5), CFrame.new(andreyPos + Vector3.new(8, 5, -6.5)), Color3.fromRGB(50, 50, 50), Enum.Material.Metal, andreyShop)
	local lamp = makePart("Lamp", Vector3.new(1.2, 1.2, 1.2), CFrame.new(andreyPos + Vector3.new(8, 10, -6.5)), Color3.fromRGB(255, 230, 100), Enum.Material.Neon, andreyShop, Enum.PartType.Ball)
	local light = Instance.new("PointLight"); light.Range = 20; light.Brightness = 2; light.Parent = lamp

	-- ========== РУЧНАЯ СБОРКА ДЕДА (Мгновенно) ==========
	local function spawnManualAndrey()
		local rig = Instance.new("Model")
		rig.Name = "Andrey"

		local function createLimb(name, size, color)
			local p = Instance.new("Part")
			p.Name, p.Size, p.Color, p.Material = name, size, color, Enum.Material.SmoothPlastic
			p.Anchored = false
			p.CanCollide = false
			p.Parent = rig
			return p
		end

		-- Тело (клетчатая рубашка)
		local torso = createLimb("Torso", Vector3.new(2, 2, 1), Color3.fromRGB(160, 82, 45))
		torso.CFrame = CFrame.new(andreyPos + Vector3.new(0, 3.8, 0.5)) * CFrame.Angles(0, 0, 0)
		rig.PrimaryPart = torso

		-- Голова
		local head = createLimb("Head", Vector3.new(1.2, 1.2, 1.2), Color3.fromRGB(234, 184, 146))
		head.CFrame = torso.CFrame * CFrame.new(0, 1.6, 0)

		-- Руки и ноги
		local la = createLimb("LeftArm", Vector3.new(1, 2, 1), Color3.fromRGB(234, 184, 146))
		la.CFrame = torso.CFrame * CFrame.new(-1.5, 0, 0)
		local ra = createLimb("RightArm", Vector3.new(1, 2, 1), Color3.fromRGB(234, 184, 146))
		ra.CFrame = torso.CFrame * CFrame.new(1.5, 0, 0)
		local ll = createLimb("LeftLeg", Vector3.new(1, 2, 1), Color3.fromRGB(54, 39, 28))
		ll.CFrame = torso.CFrame * CFrame.new(-0.5, -2, 0)
		local rl = createLimb("RightLeg", Vector3.new(1, 2, 1), Color3.fromRGB(54, 39, 28))
		rl.CFrame = torso.CFrame * CFrame.new(0.5, -2, 0)

		-- Сварки, чтобы не развалился
		local function weld(p1, p2)
			local w = Instance.new("WeldConstraint")
			w.Part0 = p1; w.Part1 = p2; w.Parent = p1
		end
		weld(torso, head); weld(torso, la); weld(torso, ra); weld(torso, ll); weld(torso, rl)

		-- Борода (3 части)
		local function beard(size, offset)
			local b = createLimb("Beard", size, Color3.fromRGB(220, 220, 220))
			b.Material = Enum.Material.Fabric
			b.CFrame = head.CFrame * offset
			weld(head, b)
		end
		beard(Vector3.new(1.4, 1.2, 0.6), CFrame.new(0, -0.6, -0.4))
		beard(Vector3.new(0.4, 1.5, 0.5), CFrame.new(-0.6, -0.4, -0.5) * CFrame.Angles(0, 0, math.rad(-15)))
		beard(Vector3.new(0.4, 1.5, 0.5), CFrame.new(0.6, -0.4, -0.5) * CFrame.Angles(0, 0, math.rad(15)))

		-- Шапка
		local hat = createLimb("Hat", Vector3.new(1.8, 0.6, 1.8), Color3.fromRGB(80, 50, 30))
		hat.Material = Enum.Material.Fabric
		hat.CFrame = head.CFrame * CFrame.new(0, 0.5, 0)
		weld(head, hat)

		rig.Parent = andreyShop

		-- Стул под деда
		local seat = Instance.new("Seat")
		seat.Size = Vector3.new(2, 0.5, 2)
		seat.CFrame = torso.CFrame
		seat.Anchored = true; seat.Transparency = 1; seat.CanCollide = false
		seat.Parent = andreyShop

		task.wait(0.1)
		-- Фиксируем на месте
		for _, p in ipairs(rig:GetChildren()) do
			if p:IsA("BasePart") then p.Anchored = true end
		end
	end

	spawnManualAndrey()

	-- Кнопка на прилавке
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Купить улей"
	prompt.ObjectText = "Плотник Андрей"
	prompt.HoldDuration = 0; prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = top
	prompt.Triggered:Connect(function(player)
		openEvent:FireClient(player)
	end)
end)

-- Логика покупки
buyHiveFn.OnServerInvoke = function(plr)
	local plotIdx = plr:GetAttribute("PlotIndex")
	if not plotIdx then return false, "Ошибка участка" end
	local hivesFolder = plr:FindFirstChild("Hives")
	if not hivesFolder then return false, "Данные не загружены" end
	if #hivesFolder:GetChildren() >= MAX_HIVES then return false, "Максимум 8 ульев!" end
	local coins = plr:FindFirstChild("leaderstats") and plr.leaderstats:FindFirstChild("Монеты")
	if not coins or coins.Value < HIVE_PRICE then return false, "Не хватает монет!" end
	coins.Value -= HIVE_PRICE
	local hiveNum = #hivesFolder:GetChildren() + 1
	local v = Instance.new("IntValue"); v.Name = "Hive" .. hiveNum; v.Value = 0; v.Parent = hivesFolder

	-- ИСПРАВЛЕНО ЗДЕСЬ: FireClient вместо Fire
	-- Используем BindableEvent для связи сервер-сервер
	local bindable = RS:FindFirstChild("UpdateHivesBindable")
	if not bindable then
		bindable = Instance.new("BindableEvent")
		bindable.Name = "UpdateHivesBindable"
		bindable.Parent = RS
	end
	bindable:Fire(plr, hiveNum)

	return true, "Куплен улей №" .. hiveNum .. "!"
end]]></ProtectedString>

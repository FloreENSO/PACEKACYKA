			<Item class="LocalScript" referent="RBX3D3FD4024B1E4A7AB3055C08FE5B6CDF">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local openEvent = RS:WaitForChild("OpenAndreyShop")
local buyFn = RS:WaitForChild("BuyHive")
local hivesF = player:WaitForChild("Hives")

local C = {
	dark = Color3.fromRGB(14, 32, 76), mid = Color3.fromRGB(26, 62, 140),
	btn = Color3.fromRGB(46, 112, 220), hover = Color3.fromRGB(74, 146, 245),
	line = Color3.fromRGB(130, 190, 255), text = Color3.fromRGB(235, 244, 255),
	sub = Color3.fromRGB(150, 185, 235), gold = Color3.fromRGB(255, 214, 90),
	ok = Color3.fromRGB(130, 235, 160), bad = Color3.fromRGB(255, 130, 130),
}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = r}, o) end
local function outline(o, color, th, tr)
	new("UIStroke", {Color = color, Thickness = th, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end
local function label(parent, str, size, pos, ts, color, font, anchor)
	return new("TextLabel", {
		Text = str, Size = size, Position = pos, AnchorPoint = anchor or Vector2.zero,
		BackgroundTransparency = 1, TextSize = ts, TextColor3 = color,
		Font = font or Enum.Font.GothamBold, TextWrapped = true,
	}, parent)
end
local function button(parent, str, size, pos, ts, anchor, radius)
	local b = new("TextButton", {
		Text = str, Size = size, Position = pos, AnchorPoint = anchor or Vector2.zero,
		BackgroundColor3 = C.btn, TextColor3 = C.text, TextSize = ts,
		Font = Enum.Font.GothamBold, AutoButtonColor = false,
	}, parent)
	round(b, radius or UDim.new(0, 12))
	outline(b, C.line, 1.5, 0.4)
	b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = C.hover}):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = C.btn}):Play() end)
	return b
end

local gui = new("ScreenGui", {Name = "AndreyShop", ResetOnSpawn = false, Enabled = false, DisplayOrder = 20}, player:WaitForChild("PlayerGui"))
local f = new("Frame", {
	Size = UDim2.fromOffset(450, 350), Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1)
}, gui)
round(f, UDim.new(0, 24))
outline(f, C.line, 2.5, 0.15)
new("UIGradient", {Color = ColorSequence.new(C.mid, C.dark), Rotation = 90}, f)
local scale = new("UIScale", {}, f)
local cam = workspace.CurrentCamera
local function fit() scale.Scale = math.clamp(cam.ViewportSize.Y / 700, 0.55, 1.15) end
fit()
cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

label(f, "Плотник Андрей", UDim2.new(1, -140, 0, 36), UDim2.new(0.5, 0, 0, 14), 26, C.text, nil, Vector2.new(0.5, 0))
local x = button(f, "X", UDim2.fromOffset(36, 36), UDim2.new(1, -14, 0, 14), 18, Vector2.new(1, 0))
x.MouseButton1Click:Connect(function() gui.Enabled = false end)

local desc = label(f, "Я строю ульи для твоей пасеки. Максимум 8 штук на участок. В один улей влезает 5 пчел.", UDim2.new(1, -40, 0, 60), UDim2.new(0.5, 0, 0, 60), 16, C.sub, Enum.Font.GothamMedium, Vector2.new(0.5, 0))
local info = label(f, "", UDim2.new(1, -40, 0, 40), UDim2.new(0.5, 0, 0, 160), 20, C.gold, nil, Vector2.new(0.5, 0))
local msg = label(f, "", UDim2.new(1, -40, 0, 30), UDim2.new(0.5, 0, 0, 280), 16, C.ok, Enum.Font.GothamMedium, Vector2.new(0.5, 0))

local buyBtn = button(f, "Купить улей (1500 монет)", UDim2.fromOffset(300, 50), UDim2.new(0.5, 0, 0, 210), 18, Vector2.new(0.5, 0))

local function refresh()
	local count = #hivesF:GetChildren()
	info.Text = "У вас ульев: " .. count .. " / 8"
	buyBtn.Text = count >= 8 and "Максимум ульев" or "Купить улей (1500 монет)"
	buyBtn.BackgroundColor3 = count >= 8 and C.bad or C.btn
end

hivesF.ChildAdded:Connect(function()
	task.wait(0.1)
	refresh()
end)
buyBtn.MouseButton1Click:Connect(function()
	local ok, success, message = pcall(buyFn.InvokeServer, buyFn)
	if not ok then success, message = false, "Ошибка" end
	msg.Text = message
	msg.TextColor3 = success and C.ok or C.bad
	refresh()
end)

openEvent.OnClientEvent:Connect(function()
	refresh()
	gui.Enabled = true
end)
]]></ProtectedString>

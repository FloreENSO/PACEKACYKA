				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local hivesFolder = player:WaitForChild("Hives")
local beesFolder = player:WaitForChild("Bees")
local addBeeFn = RS:WaitForChild("AddBeeToHive")
local removeBeeFn = RS:WaitForChild("RemoveBeeFromHive")
local collectHoneyEvent = RS:WaitForChild("CollectHoneyFromHive")
local openMenuEvent = RS:WaitForChild("OpenHiveMenu")
local BeeData = require(RS:WaitForChild("BeeData"))

local C = {
	dark = Color3.fromRGB(14, 32, 76), mid = Color3.fromRGB(26, 62, 140),
	btn = Color3.fromRGB(46, 112, 220), hover = Color3.fromRGB(74, 146, 245),
	line = Color3.fromRGB(130, 190, 255), text = Color3.fromRGB(235, 244, 255),
	sub = Color3.fromRGB(150, 185, 235), gold = Color3.fromRGB(255, 214, 90),
	ok = Color3.fromRGB(130, 235, 160), bad = Color3.fromRGB(255, 130, 130),
}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = r}, o) end
local function outline(o, color, th, tr)
	new("UIStroke", {Color = color, Thickness = th, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end

local gui = new("ScreenGui", {Name = "MyHivesUI", ResetOnSpawn = false, DisplayOrder = 15}, playerGui)

-- Кнопка "Мои ульи"
local toggleBtn = new("TextButton", {
	Size = UDim2.fromOffset(120, 46),
	Position = UDim2.new(0, 20, 0.5, 25),
	BackgroundColor3 = C.btn,
	Text = "Мои ульи",
	TextColor3 = C.text,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	AutoButtonColor = false,
}, gui)
round(toggleBtn, UDim.new(0, 12))
outline(toggleBtn, C.line, 1.5, 0.4)

toggleBtn.MouseEnter:Connect(function() TweenService:Create(toggleBtn, TweenInfo.new(0.12), {BackgroundColor3 = C.hover}):Play() end)
toggleBtn.MouseLeave:Connect(function() TweenService:Create(toggleBtn, TweenInfo.new(0.12), {BackgroundColor3 = C.btn}):Play() end)

-- Главное окно
local mainFrame = new("Frame", {
	Size = UDim2.fromOffset(700, 500),
	Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundColor3 = Color3.new(1, 1, 1),
	Visible = false,
}, gui)
round(mainFrame, UDim.new(0, 20))
outline(mainFrame, C.line, 2, 0.15)
new("UIGradient", {Color = ColorSequence.new(C.mid, C.dark), Rotation = 90}, mainFrame)

local closeBtn = new("TextButton", {
	Size = UDim2.fromOffset(36, 36),
	Position = UDim2.new(1, -46, 0, 16),
	BackgroundColor3 = C.btn, Text = "X", TextColor3 = C.text,
	Font = Enum.Font.GothamBold, TextSize = 18, AutoButtonColor = false,
}, mainFrame)
round(closeBtn, UDim.new(0, 8))
closeBtn.MouseButton1Click:Connect(function() mainFrame.Visible = false end)

new("TextLabel", {
	Size = UDim2.new(1, -40, 0, 40), Position = UDim2.new(0.5, 0, 0, 16), AnchorPoint = Vector2.new(0.5, 0),
	BackgroundTransparency = 1, Text = "Мои ульи", TextColor3 = C.text,
	Font = Enum.Font.GothamBold, TextSize = 28,
}, mainFrame)

-- Сетка для ульев (слева)
local grid = new("ScrollingFrame", {
	Size = UDim2.new(0.5, -30, 1, -80), Position = UDim2.new(0, 20, 0, 60),
	BackgroundTransparency = 1, ScrollBarThickness = 6, ScrollBarImageColor3 = C.line, CanvasSize = UDim2.new(0,0,0,0),
}, mainFrame)
new("UIGridLayout", {CellSize = UDim2.fromOffset(100, 100), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder}, grid)

-- Панель информации (справа)
local infoPanel = new("Frame", {
	Size = UDim2.new(0.5, -30, 1, -80), Position = UDim2.new(0.5, 10, 0, 60),
	BackgroundColor3 = Color3.fromRGB(20, 40, 80), Visible = false,
}, mainFrame)
round(infoPanel, UDim.new(0, 12))

local hiveTitle = new("TextLabel", {Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0.5, 0, 0, 10), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Text = "Улей №1", TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 22}, infoPanel)
local hiveDesc = new("TextLabel", {Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0.5, 0, 0, 45), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Text = "Пчел: 0 / 5", TextColor3 = C.sub, Font = Enum.Font.GothamMedium, TextSize = 16}, infoPanel)

-- Список пчел для добавления
local beeList = new("ScrollingFrame", {Size = UDim2.new(1, -20, 0, 146), Position = UDim2.new(0, 10, 0, 162), BackgroundTransparency = 1, ScrollBarThickness = 4, CanvasSize = UDim2.new(0,0,0,0)}, infoPanel)
new("UIListLayout", {Padding = UDim.new(0, 6)}, beeList)

-- Список пчел внутри улья (для удаления)
new("TextLabel", {Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 10, 0, 312), BackgroundTransparency = 1, Text = "Пчелы в улье (нажми, чтобы убрать):", TextColor3 = C.gold, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left}, infoPanel)
local hiveBeeList = new("ScrollingFrame", {Size = UDim2.new(1, -20, 0, 68), Position = UDim2.new(0, 10, 0, 330), BackgroundTransparency = 1, ScrollBarThickness = 4, CanvasSize = UDim2.new(0,0,0,0)}, infoPanel)
new("UIListLayout", {Padding = UDim.new(0, 6)}, hiveBeeList)

local msg = new("TextLabel", {Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0.5, 0, 1, -22), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Text = "", TextColor3 = C.ok, Font = Enum.Font.GothamMedium, TextSize = 14}, infoPanel)

local currentHiveIdx = 1
local selectedHiveBtn = nil

-- Секция меда в улье (иконки баночек, цвет = цвет цветка)
new("TextLabel", {Size = UDim2.new(1, -125, 0, 18), Position = UDim2.new(0, 10, 0, 64), BackgroundTransparency = 1, Text = "Мед в улье (клик — забрать):", TextColor3 = C.gold, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left}, infoPanel)

local collectAllBtn = new("TextButton", {
	Size = UDim2.fromOffset(105, 22), Position = UDim2.new(1, -10, 0, 62), AnchorPoint = Vector2.new(1, 0),
	BackgroundColor3 = C.btn, Text = "Забрать всё", TextColor3 = C.text,
	Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false,
}, infoPanel)
round(collectAllBtn, UDim.new(0, 6))

local honeyRow = new("ScrollingFrame", {
	Size = UDim2.new(1, -20, 0, 76), Position = UDim2.new(0, 10, 0, 84),
	BackgroundTransparency = 1, ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, 0),
	ScrollingDirection = Enum.ScrollingDirection.X,
}, infoPanel)
new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6)}, honeyRow)

local function refreshInfo()
	local hiveData = hivesFolder:FindFirstChild("Hive" .. currentHiveIdx)
	if not hiveData then return end

	hiveTitle.Text = "Улей №" .. currentHiveIdx
	hiveDesc.Text = "Пчел внутри: " .. hiveData.Value .. " / 5"
	msg.Text = ""

	for _, child in ipairs(beeList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, child in ipairs(hiveBeeList:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	for _, child in ipairs(honeyRow:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	-- мед, накопленный в улье
	local honeyCount = 0
	for _, child in ipairs(hiveData:GetChildren()) do
		if child:IsA("IntValue") and child:GetAttribute("IsHoney") then
			honeyCount += 1
			local rarity = child:GetAttribute("Rarity") or "Мед"
			local color = Color3.new(child:GetAttribute("ColorR") or 1, child:GetAttribute("ColorG") or 0.8, child:GetAttribute("ColorB") or 0.2)
			local mutated = child:GetAttribute("Mutated")
			local entryName = child.Name

			local btn = new("TextButton", {
				Size = UDim2.fromOffset(64, 72), BackgroundColor3 = C.btn, Text = "",
				TextColor3 = C.text, AutoButtonColor = false,
			}, honeyRow)
			round(btn, UDim.new(0, 8))
			outline(btn, mutated and C.gold or C.line, 1.5, 0.4)
			new("ImageLabel", {
				Size = UDim2.fromOffset(42, 42), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0),
				BackgroundTransparency = 1, Image = "rbxassetid://7067803446", ImageColor3 = color,
			}, btn)
			new("TextLabel", {
				Size = UDim2.new(1, -2, 0, 13), Position = UDim2.new(0, 0, 0, 49), BackgroundTransparency = 1,
				Text = rarity .. (mutated and " ★" or ""), TextColor3 = mutated and C.gold or C.text,
				Font = Enum.Font.GothamMedium, TextSize = 9, TextTruncate = Enum.TextTruncate.AtEnd,
			}, btn)
			new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 62), BackgroundTransparency = 1,
				Text = "x" .. child.Value, TextColor3 = C.sub,
				Font = Enum.Font.GothamBold, TextSize = 12,
			}, btn)

			btn.MouseButton1Click:Connect(function()
				collectHoneyEvent:FireServer(currentHiveIdx, entryName)
				task.wait(0.3)
				refreshInfo()
			end)
		end
	end
	if honeyCount == 0 then
		new("TextLabel", {Size = UDim2.new(0, 210, 1, 0), BackgroundTransparency = 1, Text = "Меда пока нет — пчелы трудятся!", TextColor3 = C.sub, Font = Enum.Font.GothamMedium, TextSize = 13}, honeyRow)
	end
	honeyRow.CanvasSize = UDim2.new(0, math.max(honeyCount, 1) * 70, 0, 0)

	for _, beeInfo in ipairs(BeeData) do
		local owned = beesFolder:FindFirstChild(beeInfo.name)
		local count = owned and owned.Value or 0

		local btn = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.btn, Text = beeInfo.name .. " (Есть: " .. count .. ")",
			TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 14, AutoButtonColor = false,
		}, beeList)
		round(btn, UDim.new(0, 6))

		if count > 0 and hiveData.Value < 5 then
			btn.BackgroundColor3 = C.hover
			btn.MouseButton1Click:Connect(function()
				local ok, success, message = pcall(addBeeFn.InvokeServer, addBeeFn, currentHiveIdx, beeInfo.name)
				if not ok then success, message = false, "Ошибка" end
				msg.Text = message
				msg.TextColor3 = success and C.ok or C.bad
				task.wait(0.5)
				refreshInfo()
			end)
		else
			btn.BackgroundColor3 = C.dark
			btn.TextColor3 = C.sub
		end
	end
	beeList.CanvasSize = UDim2.new(0, 0, 0, #BeeData * 40)

	-- пчелы, которые сейчас внутри улья
	local hiveBeeCount = 0
	for _, comp in ipairs(hiveData:GetChildren()) do
		if comp:IsA("IntValue") and comp.Value > 0 and not comp:GetAttribute("IsHoney") then
			hiveBeeCount += 1
			local beeName = comp.Name
			local rBtn = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(150, 60, 60),
				Text = beeName .. " x" .. comp.Value .. "  [Убрать]",
				TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 14, AutoButtonColor = false,
			}, hiveBeeList)
			round(rBtn, UDim.new(0, 6))
			rBtn.MouseButton1Click:Connect(function()
				local ok, success, message = pcall(removeBeeFn.InvokeServer, removeBeeFn, currentHiveIdx, beeName)
				if not ok then success, message = false, "Ошибка" end
				msg.Text = message
				msg.TextColor3 = success and C.ok or C.bad
				task.wait(0.5)
				refreshInfo()
			end)
		end
	end
	if hiveBeeCount == 0 then
		new("TextLabel", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "Улей пуст", TextColor3 = C.sub, Font = Enum.Font.GothamMedium, TextSize = 13}, hiveBeeList)
	end
	hiveBeeList.CanvasSize = UDim2.new(0, 0, 0, math.max(hiveBeeCount, 1) * 36)
end

collectAllBtn.MouseButton1Click:Connect(function()
	collectHoneyEvent:FireServer(currentHiveIdx, nil)
	task.wait(0.3)
	refreshInfo()
end)

local function refreshGrid()
	for _, child in ipairs(grid:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	for i = 1, 8 do
		local hiveData = hivesFolder:FindFirstChild("Hive" .. i)
		if hiveData then
			local btn = new("TextButton", {
				Size = UDim2.fromOffset(100, 100), BackgroundColor3 = C.btn,
				Text = "Улей\n№" .. i .. "\n(" .. hiveData.Value .. "/5)", TextColor3 = C.text,
				Font = Enum.Font.GothamBold, TextSize = 16, AutoButtonColor = false,
			}, grid)
			round(btn, UDim.new(0, 12))
			outline(btn, C.line, 1.5, 0.4)

			btn.MouseButton1Click:Connect(function()
				currentHiveIdx = i
				infoPanel.Visible = true
				refreshInfo()
			end)
		end
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
	if mainFrame.Visible then
		refreshGrid()
		infoPanel.Visible = false
	end
end)

-- Открытие меню по клику/подходу к улью (с сервера)
openMenuEvent.OnClientEvent:Connect(function(hiveIndex)
	if type(hiveIndex) == "number" then
		currentHiveIdx = hiveIndex
	end
	mainFrame.Visible = true
	refreshGrid()
	infoPanel.Visible = true
	refreshInfo()
end)

hivesFolder.ChildAdded:Connect(function()
	task.wait(0.1)
	if mainFrame.Visible then refreshGrid() end
end)

-- Слушаем обновления с сервера
local refreshUI = RS:FindFirstChild("RefreshHiveUI")
if not refreshUI then
	refreshUI = Instance.new("RemoteEvent")
	refreshUI.Name = "RefreshHiveUI"
	refreshUI.Parent = RS
end

refreshUI.OnClientEvent:Connect(function()
	if mainFrame.Visible then
		refreshGrid()
		refreshInfo()
	end
end)]]></ProtectedString>

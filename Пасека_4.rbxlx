		<Item class="LocalScript" referent="RBXDD6DDC86DFF04312B2F00413198663F5">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "Welcome"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(0.5, 0)
label.Position = UDim2.fromScale(0.5, 0.12)
label.Size = UDim2.fromScale(0.6, 0.08)
label.BackgroundTransparency = 1
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.TextColor3 = Color3.fromRGB(255, 214, 70)
label.TextStrokeColor3 = Color3.fromRGB(80, 50, 20)
label.TextTransparency = 1
label.TextStrokeTransparency = 1
label.Parent = gui

local token = 0
local function showWelcome()
	token += 1
	local my = token
	label.Text = "Добро пожаловать на пасеку, " .. player.DisplayName .. "!"
	label.TextTransparency = 1
	label.TextStrokeTransparency = 1
	TweenService:Create(label, TweenInfo.new(0.6), {TextTransparency = 0, TextStrokeTransparency = 0.3}):Play()
	task.wait(4)
	if token ~= my then return end
	TweenService:Create(label, TweenInfo.new(1), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
end

player.CharacterAdded:Connect(function()
	task.spawn(showWelcome)
end)
if player.Character then
	task.spawn(showWelcome)
end]]></ProtectedString>

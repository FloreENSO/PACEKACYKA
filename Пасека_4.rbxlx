		<Item class="Script" referent="RBXC3E9B99B6F654F9E90319B386BDD5499">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

-- ================== ТЕКСТЫ ШАГОВ ==================
local TEXTS = {
	[1] = "Шаг 1/5: Подойди к плотнику Андрею и купи улей (1500 монет)",
	[2] = "Шаг 2/5: Купи пчелу у пчеловода Ивана",
	[3] = "Шаг 3/5: Посади пчелу в улей — нажми кнопку «Мои ульи»",
	[4] = "Шаг 4/5: Дождись мёда и забери банку у улья (E)",
	[5] = "Шаг 5/5: Продай мёд пчеловоду Ивану",
	[6] = "Обучение завершено! Отличной работы!",
}

local REWARD = 500 -- награда за прохождение обучения

local function setStep(plr, n)
	plr:SetAttribute("TutorialStep", n)
	plr:SetAttribute("TutorialText", TEXTS[n] or "")
end

-- Завершение обучения + награда (только для тех, кто прошёл всё с нуля за сессию)
local function finish(plr)
	if plr:GetAttribute("TutorialStep") == 6 then return end
	setStep(plr, 6)
	if not plr:GetAttribute("TutorialFresh") then return end
	local stats = plr:FindFirstChild("leaderstats")
	local coins = stats and stats:FindFirstChild("Монеты")
	if coins then
		coins.Value += REWARD
	end
end

-- Определить стартовый шаг по текущему прогрессу игрока
local function computeStep(plr)
	local hives = plr:FindFirstChild("Hives")
	local bees = plr:FindFirstChild("Bees")
	local honey = plr:FindFirstChild("Honey")
	local s = 1
	if hives and #hives:GetChildren() > 0 then s = 2 end
	if bees then
		for _, v in ipairs(bees:GetChildren()) do
			if v:IsA("IntValue") and v.Value > 0 then s = 3 break end
		end
	end
	if s >= 3 and hives then
		for _, v in ipairs(hives:GetChildren()) do
			if v:IsA("IntValue") and v.Value > 0 then s = 4 end
		end
	end
	if s >= 4 and honey and #honey:GetChildren() > 0 then s = 5 end
	return s
end

-- Перейти на следующий шаг, если игрок сейчас на expectedStep
local function advance(plr, expectedStep)
	if plr:GetAttribute("TutorialStep") ~= expectedStep then return end
	if expectedStep >= 5 then
		finish(plr)
		return
	end
	local nextStep = expectedStep + 1
	-- если игрок уже выполнил и следующие шаги (например, купил пчелу раньше улья) — перескакиваем
	local s = computeStep(plr)
	if s > nextStep then nextStep = s end
	setStep(plr, nextStep)
end

-- ================== НАБЛЮДАТЕЛИ ЗА ПАПКАМИ ==================
local function watchHoney(plr, folder)
	local function trackValue(v)
		if not v:IsA("IntValue") then return end
		local last = v.Value
		v.Changed:Connect(function(nv)
			-- количество уменьшилось = мёд продан
			if nv < last then advance(plr, 5) end
			last = nv
		end)
	end
	folder.ChildAdded:Connect(function(v)
		advance(plr, 4) -- игрок получил мёд
		trackValue(v)
	end)
	for _, v in ipairs(folder:GetChildren()) do trackValue(v) end
end

local function watchBees(plr, folder)
	-- записи о всех породах создаются заранее со значением 0,
	-- поэтому шаг 2 завершается, когда любая пчела куплена (значение стало > 0)
	local function trackValue(v)
		if not v:IsA("IntValue") then return end
		v.Changed:Connect(function(nv)
			if nv > 0 then advance(plr, 2) end
		end)
	end
	folder.ChildAdded:Connect(trackValue)
	for _, v in ipairs(folder:GetChildren()) do trackValue(v) end
end

local function watchHives(plr, folder)
	local function trackValue(v)
		if not v:IsA("IntValue") then return end
		v.Changed:Connect(function(nv)
			-- в улей посадили пчелу
			if nv > 0 then advance(plr, 3) end
		end)
	end
	folder.ChildAdded:Connect(function(v)
		advance(plr, 1) -- куплен первый улей
		trackValue(v)
	end)
	for _, v in ipairs(folder:GetChildren()) do trackValue(v) end
end

local function watchPlayer(plr)
	setStep(plr, 1)
	plr:SetAttribute("TutorialFresh", true)

	local function tryAttach(name, handler)
		local f = plr:FindFirstChild(name)
		if f then handler(plr, f) return true end
		return false
	end

	-- пересчёт стартового шага (для вернувшихся игроков — без награды)
	local function recompute()
		local cur = plr:GetAttribute("TutorialStep")
		if not cur or cur >= 6 then return end
		local s = computeStep(plr)
		if s > cur then
			plr:SetAttribute("TutorialFresh", false)
			setStep(plr, s)
		end
	end

	-- папки создаются другими скриптами асинхронно — ловим их появление
	plr.ChildAdded:Connect(function(child)
		if child.Name == "Hives" then watchHives(plr, child)
		elseif child.Name == "Bees" then watchBees(plr, child)
		elseif child.Name == "Honey" then watchHoney(plr, child)
		end
		recompute()
	end)

	-- папки, которые уже успели создаться
	tryAttach("Hives", watchHives)
	tryAttach("Bees", watchBees)
	tryAttach("Honey", watchHoney)

	-- отложенный пересчёт для вернувшихся игроков
	task.delay(3, function()
		if plr.Parent then recompute() end
	end)
end

Players.PlayerAdded:Connect(function(plr)
	watchPlayer(plr)
end)

for _, plr in ipairs(Players:GetPlayers()) do
	task.spawn(watchPlayer, plr)
end

print("TutorialSystem запущен!")]]></ProtectedString>

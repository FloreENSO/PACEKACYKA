				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Цвета в стиле магазина Ивана
local C = {
	dark = Color3.fromRGB(14, 32, 76), mid = Color3.fromRGB(26, 62, 140),
	btn = Color3.fromRGB(46, 112, 220), hover = Color3.fromRGB(74, 146, 245),
	line = Color3.fromRGB(130, 190, 255), text = Color3.fromRGB(235, 244, 255),
	sub = Color3.fromRGB(150, 185, 235), gold = Color3.fromRGB(255, 214, 90),
}

-- Помощники для UI
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = r}, o) end
local function outline(o, color, th, tr)
	new("UIStroke", {Color = color, Thickness = th, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end

-- Главный ScreenGui
local gui = new("ScreenGui", {Name = "InventoryUI", ResetOnSpawn = false, DisplayOrder = 15}, playerGui)

-- ========== КНОПКА ИНВЕНТАРЯ (слева) ==========
local toggleBtn = new("TextButton", {
	Size = UDim2.fromOffset(120, 46),
	Position = UDim2.new(0, 20, 0.5, -23),
	BackgroundColor3 = C.btn,
	Text = "Инвентарь",
	TextColor3 = C.text,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	AutoButtonColor = false,
}, gui)
round(toggleBtn, UDim.new(0, 12))
outline(toggleBtn, C.line, 1.5, 0.4)

toggleBtn.MouseEnter:Connect(function() TweenService:Create(toggleBtn, TweenInfo.new(0.12), {BackgroundColor3 = C.hover}):Play() end)
toggleBtn.MouseLeave:Connect(function() TweenService:Create(toggleBtn, TweenInfo.new(0.12), {BackgroundColor3 = C.btn}):Play() end)

-- ========== БОЛЬШОЕ ОКНО ИНВЕНТАРЯ (по центру) ==========
local invFrame = new("Frame", {
	Size = UDim2.fromOffset(900, 550), -- Сделали ГОРАЗДО шире
	Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundColor3 = Color3.new(1, 1, 1),
	Visible = false,
}, gui)
round(invFrame, UDim.new(0, 20))
outline(invFrame, C.line, 2, 0.15)
new("UIGradient", {Color = ColorSequence.new(C.mid, C.dark), Rotation = 90}, invFrame)

-- Масштабирование под экран
local scale = new("UIScale", {}, invFrame)
local cam = workspace.CurrentCamera
local function fit()
	local s = math.clamp(cam.ViewportSize.Y / 800, 0.5, 1)
	scale.Scale = s
end
fit()
cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

-- Заголовок
local title = new("TextLabel", {
	Size = UDim2.new(1, -40, 0, 40),
	Position = UDim2.new(0.5, 0, 0, 16),
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundTransparency = 1,
	Text = "Ваш инвентарь",
	TextColor3 = C.text,
	Font = Enum.Font.GothamBold,
	TextSize = 28,
}, invFrame)

-- Кнопка закрытия
local closeBtn = new("TextButton", {
	Size = UDim2.fromOffset(36, 36),
	Position = UDim2.new(1, -46, 0, 16),
	BackgroundColor3 = C.btn,
	Text = "X",
	TextColor3 = C.text,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	AutoButtonColor = false,
}, invFrame)
round(closeBtn, UDim.new(0, 8))
closeBtn.MouseButton1Click:Connect(function() invFrame.Visible = false end)

-- Вкладки (Мёд / Пчёлы)
local tabsFrame = new("Frame", {
	Size = UDim2.new(1, -40, 0, 44),
	Position = UDim2.new(0.5, 0, 0, 70),
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundTransparency = 1,
}, invFrame)
new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), HorizontalAlignment = Enum.HorizontalAlignment.Center}, tabsFrame)

local btnHoney, btnBees
local function createTab(name, size)
	local b = new("TextButton", {
		Size = size,
		BackgroundColor3 = C.btn,
		Text = name,
		TextColor3 = C.text,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		AutoButtonColor = false,
	}, tabsFrame)
	round(b, UDim.new(0, 10))
	outline(b, C.line, 1, 0.5)
	return b
end
btnHoney = createTab("Мёд", UDim2.fromOffset(300, 44))
btnBees = createTab("Пчёлы", UDim2.fromOffset(300, 44))

-- Контейнер для списка предметов
local listContainer = new("ScrollingFrame", {
	Size = UDim2.new(1, -60, 1, -190),
	Position = UDim2.new(0.5, 0, 0, 130),
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundTransparency = 1,
	ScrollBarThickness = 8,
	ScrollBarImageColor3 = C.line,
	CanvasSize = UDim2.new(0, 0, 0, 0),
}, invFrame)
new("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder}, listContainer)

-- ========== ЛОГИКА ВКЛАДОК ==========
local activeTab = "Honey"

local function clearList()
	-- Исправление бага: удаляем ВСЁ, кроме UIListLayout
	for _, child in ipairs(listContainer:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

local function createItemRow(name, count, color)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Color3.fromRGB(30, 45, 80),
	}, listContainer)
	round(row, UDim.new(0, 10))

	-- Иконка (цветной кружок)
	local icon = new("Frame", {
		Size = UDim2.fromOffset(32, 32),
		Position = UDim2.new(0, 16, 0.5, -16),
		BackgroundColor3 = color,
	}, row)
	round(icon, UDim.new(1, 0))

	-- Название
	new("TextLabel", {
		Size = UDim2.new(1, -180, 1, 0),
		Position = UDim2.fromOffset(60, 0),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = C.text,
		Font = Enum.Font.GothamMedium,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	-- Количество
	new("TextLabel", {
		Size = UDim2.fromOffset(120, 56),
		Position = UDim2.new(1, -136, 0, 0),
		BackgroundTransparency = 1,
		Text = "x" .. count,
		TextColor3 = C.gold,
		Font = Enum.Font.GothamBold,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
end

local function refreshInventory()
	clearList()

	local hasItems = false

	if activeTab == "Honey" then
		btnHoney.BackgroundColor3 = C.hover
		btnBees.BackgroundColor3 = C.btn

		local honeyFolder = player:FindFirstChild("Honey")
		if honeyFolder then
			for _, item in ipairs(honeyFolder:GetChildren()) do
				if item:IsA("IntValue") and item.Value > 0 then
					hasItems = true
					local col = Color3.fromRGB(255, 190, 40) -- Обычный
					if item.Name == "Редкий" then col = Color3.fromRGB(60, 160, 255)
					elseif item.Name == "Эпический" then col = Color3.fromRGB(180, 60, 255)
					elseif item.Name == "Легендарный" then col = Color3.fromRGB(255, 160, 20)
					elseif item.Name == "Мифический" then col = Color3.fromRGB(255, 40, 100)
					end
					createItemRow(item.Name .. " мёд", item.Value, col)
				end
			end
		end
	elseif activeTab == "Bees" then
		btnHoney.BackgroundColor3 = C.btn
		btnBees.BackgroundColor3 = C.hover

		local beesFolder = player:FindFirstChild("Bees")
		if beesFolder then
			for _, item in ipairs(beesFolder:GetChildren()) do
				if item:IsA("IntValue") and item.Value > 0 then
					hasItems = true
					createItemRow(item.Name .. " пчела", item.Value, Color3.fromRGB(255, 220, 100))
				end
			end
		end
	end

	-- Если пусто, пишем текст ОДИН раз
	if not hasItems then
		local emptyText = new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 60),
			BackgroundTransparency = 1,
			Text = "Здесь пока пусто...",
			TextColor3 = C.sub,
			Font = Enum.Font.GothamMedium,
			TextSize = 18,
		}, listContainer)
	end

	listContainer.CanvasSize = UDim2.new(0, 0, 0, #listContainer:GetChildren() * 66)
end

btnHoney.MouseButton1Click:Connect(function() activeTab = "Honey" refreshInventory() end)
btnBees.MouseButton1Click:Connect(function() activeTab = "Bees" refreshInventory() end)

-- ========== ОТКРЫТИЕ / ЗАКРЫТИЕ ==========
toggleBtn.MouseButton1Click:Connect(function()
	invFrame.Visible = not invFrame.Visible
	if invFrame.Visible then
		refreshInventory()
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	invFrame.Visible = false
end)

-- Автообновление в реальном времени (теперь не будет дублировать текст)
task.spawn(function()
	while true do
		task.wait(1)
		if invFrame.Visible then
			refreshInventory()
		end
	end
end)]]></ProtectedString>

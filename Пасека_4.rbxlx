				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">SpawnDecor</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2dc683e6fd1b962a0b0b779600003655</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX6360DEC1ABA34AF5A4C4462B0265537A">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players, Lighting, RunService = game:GetService("Players"), game:GetService("Lighting"), game:GetService("RunService")

-- ========== НАСТРОЙКИ ==========
local MUSIC_ID = ""     -- ID спокойной музыки (цифры, в кавычках)
local PLOTS = 7         -- число пасек
local PLAZA_R = 20      -- радиус центральной площади
local PATH_W = 6        -- ширина дорожек
local FY = 0.7          -- высота пола лавки
local CR = 7            -- радиус кольцевого прилавка
local SWIVEL = 0.35     -- вращение кресла Ивана (рад/с), 0 = не вращается

local rng, C3 = Random.new(), Color3.fromRGB
local WOOD, DARK, LIGHT = C3(150, 105, 65), C3(110, 75, 45), C3(190, 145, 95)
local DIRT, DIRT_D, DIRT_L = C3(143, 112, 78), C3(118, 90, 62), C3(165, 135, 98)

local hub = Instance.new("Folder")
hub.Name, hub.Parent = "Hub", workspace

-- ========== ПОМОЩНИКИ ==========
local function box(name, size, cf, color, mat, parent)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color, p.Material = name, size, cf, color, mat
	p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Вертикальный цилиндр: высота h, диаметр d, низ на высоте y
local function cyl(name, h, d, x, y, z, color, mat, parent)
	local p = box(name, Vector3.new(h, d, d), CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function ball(name, d, pos, color, mat, parent)
	local p = box(name, Vector3.new(d, d, d), CFrame.new(pos), color, mat, parent)
	p.Shape = Enum.PartType.Ball
	return p
end

-- Текст на поверхности или над объектом
local function text(gui, str, size, color, stroke)
	local l = Instance.new("TextLabel")
	l.Size, l.BackgroundTransparency, l.Text, l.TextScaled = size or UDim2.fromScale(1, 1), 1, str, true
	l.Font, l.TextColor3, l.TextStrokeColor3, l.TextStrokeTransparency = Enum.Font.GothamBold, color, stroke, 0.2
	l.Parent = gui
end

-- ========== НЕБО ==========
for _, v in ipairs(Lighting:GetChildren()) do
	if v:IsA("Sky") or v:IsA("Atmosphere") then v:Destroy() end
end
Lighting.ClockTime, Lighting.Brightness, Lighting.OutdoorAmbient = 14, 3, C3(135, 150, 180)
Instance.new("Sky").Parent = Lighting
local atm = Instance.new("Atmosphere")
atm.Density, atm.Offset, atm.Haze, atm.Color, atm.Decay, atm.Parent = 0.25, 0.2, 0.6, C3(175, 205, 245), C3(110, 150, 200), Lighting
local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
clouds.Cover, clouds.Density, clouds.Parent = 0.6, 0.55, workspace.Terrain

-- ========== МУЗЫКА ==========
if MUSIC_ID ~= "" then
	local m = Instance.new("Sound")
	m.SoundId, m.Volume, m.Looped, m.Parent = "rbxassetid://" .. MUSIC_ID, 0.35, true, game:GetService("SoundService")
	m:Play()
end

-- ========== ПЛОЩАДЬ И ФОНАРИ ==========
cyl("PlazaEdge", 0.45, PLAZA_R * 2 + 4, 0, -0.1, 0, DIRT, Enum.Material.Ground, hub)
cyl("Plaza", 0.5, PLAZA_R * 2, 0, -0.1, 0, C3(178, 168, 150), Enum.Material.Cobblestone, hub)
for k = 1, PLOTS do
	local a = (k - 0.5) * 2 * math.pi / PLOTS
	local x, z = math.sin(a) * 17, math.cos(a) * 17
	cyl("Pole", 7, 0.5, x, 0.4, z, C3(50, 45, 40), Enum.Material.Metal, hub)
	local lamp = ball("Lamp", 1.4, Vector3.new(x, 7.7, z), C3(255, 214, 110), Enum.Material.Neon, hub)
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Parent = C3(255, 210, 120), 16, lamp
end

-- ========== 16 ПЧЁЛ: {название, цвет, цвет текста} (от обычной к самой редкой) ==========
local BEES = {
	{"Обычная", C3(205, 195, 170)}, {"Медная", C3(184, 115, 51)}, {"Серебряная", C3(200, 205, 215)},
	{"Золотая", C3(255, 200, 40)}, {"Изумрудная", C3(40, 200, 120)}, {"Рубиновая", C3(225, 35, 65)},
	{"Сапфировая", C3(50, 105, 245)}, {"Аметистовая", C3(165, 90, 235)}, {"Янтарная", C3(255, 140, 0)},
	{"Бирюзовая", C3(40, 215, 225)}, {"Розовая", C3(255, 150, 205)}, {"Обсидиановая", C3(40, 35, 55), C3(160, 135, 215)},
	{"Лунная", C3(215, 230, 255)}, {"Огненная", C3(255, 85, 25)}, {"Космическая", C3(100, 55, 215)},
	{"Радужная", C3(255, 80, 80)},
}

-- Баночка с пчелой; a - угол на круге (пчела смотрит наружу)
local function beeJar(x, y, z, rank, parent, a)
	local name, c, tc = BEES[rank][1], BEES[rank][2], BEES[rank][3]
	local jar = cyl("Jar", 1.7, 1.4, x, y, z, c:Lerp(Color3.new(1, 1, 1), 0.7), Enum.Material.Glass, parent)
	jar.Transparency = 0.55
	cyl("Lid", 0.25, 1.45, x, y + 1.7, z, DARK, Enum.Material.Wood, parent)

	local cf = CFrame.new(x, y + 0.9, z) * CFrame.Angles(0, a + math.pi, 0)
	local mark = (c.R * 0.3 + c.G * 0.59 + c.B * 0.11 > 0.3) and C3(30, 25, 20) or C3(255, 215, 90)
	local function part(size, off, color, sphere, mat, transp)
		local p = box("Bee", size, cf * off, color, mat or Enum.Material.SmoothPlastic, parent)
		p.CanCollide, p.Transparency = false, transp or 0
		if sphere then Instance.new("SpecialMesh", p).MeshType = Enum.MeshType.Sphere end
		return p
	end

	local body = part(Vector3.new(0.5, 0.5, 0.75), CFrame.new(), c, true, rank >= 14 and Enum.Material.Neon or nil)
	part(Vector3.new(0.54, 0.54, 0.14), CFrame.new(0, 0, -0.05), mark, true)
	part(Vector3.new(0.54, 0.54, 0.14), CFrame.new(0, 0, 0.22), mark, true)
	part(Vector3.new(0.32, 0.32, 0.32), CFrame.new(0, 0.02, -0.45), mark, true)
	for _, s in ipairs({-1, 1}) do
		part(Vector3.new(0.5, 0.03, 0.28), CFrame.new(s * 0.32, 0.32, -0.05) * CFrame.Angles(0, 0, s * 0.5), Color3.new(1, 1, 1), false, nil, 0.4)
	end

	if rank >= 12 then
		local l = Instance.new("PointLight")
		l.Color, l.Brightness, l.Range, l.Parent = tc or c, 0.8, 8, body
	end
	if rank == #BEES then -- радужная переливается
		task.spawn(function()
			while body.Parent do
				body.Color = Color3.fromHSV((os.clock() * 0.3) % 1, 0.9, 1)
				task.wait(0.1)
			end
		end)
	end

	-- Подпись над баночкой, смещена наружу от центра
	local g = Instance.new("BillboardGui")
	g.Adornee, g.Size, g.MaxDistance, g.LightInfluence = jar, UDim2.fromOffset(170, 42), 15, 0
	g.StudsOffsetWorldSpace = Vector3.new(math.sin(a) * 1.3, 1.7, math.cos(a) * 1.3)
	g.Parent = jar
	text(g, name .. " пчела\nРедкость " .. rank .. "/" .. #BEES, nil, tc or c:Lerp(Color3.new(1, 1, 1), 0.2), Color3.new(0, 0, 0))
end

-- ========== КРУГЛАЯ ЛАВКА ==========
-- Кольцо из сегментов (радиус центра, толщина, высота, высота центра по Y, число сегментов)
local function ring(name, radius, thickness, height, y, color, mat, parent, n)
	local step = 2 * math.pi / n
	for i = 0, n - 1 do
		local dir = Vector3.new(math.sin(i * step), 0, math.cos(i * step))
		local pos = dir * radius + Vector3.new(0, y, 0)
		box(name, Vector3.new(2 * (radius + thickness / 2) * math.tan(step / 2) * 1.04, height, thickness), CFrame.lookAt(pos, pos + dir), color, mat, parent)
	end
end

local function buildShop()
	local shop = Instance.new("Model")
	shop.Name, shop.Parent = "BeekeeperShop", hub

	cyl("Floor", 0.3, 26, 0, 0.4, 0, LIGHT, Enum.Material.WoodPlanks, shop)

	-- Круглый прилавок и 16 баночек по кругу
	ring("Counter", CR, 2.4, 3.4, FY + 1.7, WOOD, Enum.Material.WoodPlanks, shop, 28)
	ring("RingTop", CR, 3, 0.4, FY + 3.6, LIGHT, Enum.Material.Wood, shop, 28)
	for rank = 1, #BEES do
		local a = (rank - 1) * 2 * math.pi / #BEES
		beeJar(math.sin(a) * CR, FY + 3.8, math.cos(a) * CR, rank, shop, a)
	end

	-- Невидимая точка в центре: к ней крепится кнопка «Открыть магазин» (ShopServer)
	local counterTop = box("CounterTop", Vector3.new(1, 1, 1), CFrame.new(0, FY + 4, 0), LIGHT, Enum.Material.Wood, shop)
	counterTop.Transparency, counterTop.CanCollide = 1, false
	Instance.new("ProximityPrompt", counterTop) -- заглушка: ShopServer заменит её своей кнопкой

	-- Кресло Ивана в центре
	cyl("Pedestal", 1.95, 1.2, 0, FY, 0, DARK, Enum.Material.Wood, shop)
	local seat = Instance.new("Seat")
	seat.Name, seat.Size, seat.CFrame = "IvanSeat", Vector3.new(2.4, 0.5, 2.4), CFrame.new(0, FY + 2.2, 0) * CFrame.Angles(0, math.pi, 0)
	seat.Anchored, seat.Color, seat.Material, seat.Parent = true, DARK, Enum.Material.Wood, shop

	-- Столбы и ступенчатая круглая крыша
	for k = 0, 7 do
		local a = k * math.pi / 4
		cyl("Post", 7.5, 0.8, math.sin(a) * 11.5, FY, math.cos(a) * 11.5, DARK, Enum.Material.Wood, shop)
	end
	for i = 0, 7 do
		cyl("Roof", 0.55, 27 - i * 3.4, 0, FY + 7.5 + i * 0.5, 0, (i % 2 == 0) and C3(178, 84, 54) or C3(158, 68, 44), Enum.Material.Slate, shop)
	end
	ball("Finial", 1.4, Vector3.new(0, FY + 12, 0), C3(255, 190, 40), Enum.Material.Neon, shop)

	-- 4 вывески по сторонам света под краем крыши
	for k = 0, 3 do
		local dir = Vector3.new(math.sin(k * math.pi / 2), 0, math.cos(k * math.pi / 2))
		local pos = dir * 12.6 + Vector3.new(0, FY + 6.2, 0)
		local sign = box("Sign", Vector3.new(9, 2.6, 0.4), CFrame.lookAt(pos, pos + dir), DARK, Enum.Material.Wood, shop)
		sign.CanCollide = false
		local g = Instance.new("SurfaceGui")
		g.Face, g.SizingMode, g.PixelsPerStud, g.Parent = Enum.NormalId.Front, Enum.SurfaceGuiSizingMode.PixelsPerStud, 50, sign
		text(g, "Магазин\nпчеловода Ивана", nil, C3(255, 214, 70), C3(60, 35, 15))
	end

	-- Бочки вокруг
	for k = 0, 3 do
		local a = math.rad(45 + 90 * k)
		local x, z = math.sin(a) * 16, math.cos(a) * 16
		cyl("Barrel", 3, 2.4, x, 0.4, z, WOOD, Enum.Material.Wood, shop)
		for _, h in ipairs({0.6, 2.2}) do
			cyl("Band", 0.2, 2.5, x, 0.4 + h, z, C3(80, 80, 85), Enum.Material.Metal, shop)
		end
	end

	-- Кресло медленно поворачивается, чтобы Иван смотрел на всех
	if SWIVEL > 0 then
		local base, t0 = seat.CFrame, os.clock()
		RunService.Heartbeat:Connect(function()
			seat.CFrame = base * CFrame.Angles(0, (os.clock() - t0) * SWIVEL, 0)
		end)
	end
	return shop, seat
end

local shop, seat = buildShop()

-- ========== ПЧЕЛОВОД ИВАН (разговор и покупки: ShopServer + ShopClient) ==========
task.spawn(function()
	local ok, rig = pcall(function()
		local d, skin, suit = Instance.new("HumanoidDescription"), C3(234, 184, 146), C3(245, 240, 225)
		d.HeadColor, d.LeftArmColor, d.RightArmColor, d.TorsoColor, d.LeftLegColor, d.RightLegColor = skin, suit, suit, suit, suit, suit
		return Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15)
	end)
	if not ok or not rig then warn("Hub: не удалось создать Ивана") return end

	rig.Name, rig.Parent = "Ivan", shop
	rig:PivotTo(CFrame.new(0, FY + 4.45, 0) * CFrame.Angles(0, math.pi, 0))

	local hum = rig:WaitForChild("Humanoid")
	hum.DisplayName, hum.DisplayDistanceType, hum.NameDisplayDistance = "Пчеловод Иван", Enum.HumanoidDisplayDistanceType.Subject, 40
	hum.HealthDisplayType, hum.WalkSpeed, hum.JumpHeight = Enum.HumanoidHealthDisplayType.AlwaysOff, 0, 0

	task.wait(1)
	seat:Sit(hum)
	pcall(function() -- анимация сидения; если не загрузится, Иван просто сидит
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://2506281703"
		local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
		animator:LoadAnimation(anim):Play()
	end)

	-- Шляпа с сеткой
	local head, straw = rig:WaitForChild("Head"), C3(226, 190, 110)
	local function hat(size, y, color, mat, transp)
		local p = Instance.new("Part")
		p.Size, p.Color, p.Material, p.Transparency, p.Shape = size, color, mat, transp or 0, Enum.PartType.Cylinder
		p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
		p.CFrame = head.CFrame * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.pi / 2)
		p.Parent = rig
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1, w.Parent = head, p, p
	end
	hat(Vector3.new(0.15, 3.4, 3.4), 0.5, straw, Enum.Material.Fabric)
	hat(Vector3.new(0.9, 1.9, 1.9), 0.95, straw, Enum.Material.Fabric)
	hat(Vector3.new(0.25, 1.95, 1.95), 0.75, C3(90, 60, 35), Enum.Material.Fabric)
	hat(Vector3.new(1.6, 2.3, 2.3), -0.1, C3(40, 40, 40), Enum.Material.SmoothPlastic, 0.7)
end)

-- ========== ПРОТОПТАННЫЕ ДОРОЖКИ ==========
local layer = 0
local function buildPath(plot, index)
	local ground = plot:WaitForChild("Ground", 10)
	if not ground then return end

	local gate = (ground.CFrame * CFrame.new(0, 0, -ground.Size.Z / 2)).Position
	local flat = Vector3.new(gate.X, 0, gate.Z)
	local dist, dir = flat.Magnitude, flat.Unit
	local right, r0 = Vector3.new(dir.Z, 0, -dir.X), PLAZA_R - 2
	local len = dist - r0

	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Path" .. index, hub

	local function strip(name, w, h, l, r, color)
		local pos = dir * r + Vector3.new(0, h / 2, 0)
		box(name, Vector3.new(w, h, l), CFrame.lookAt(pos, pos + dir), color, Enum.Material.Ground, folder)
	end
	strip("Shoulder", PATH_W + 2.4, 0.2, len - 2, r0 + len / 2, DIRT_L)
	strip("Path", PATH_W, 0.42, len, r0 + len / 2, DIRT)
	strip("Step", PATH_W + 1, 0.72, 4, dist - 2, DIRT)

	for _ = 1, 30 do -- потёртости
		local p = dir * (r0 + rng:NextNumber(1, len - 5)) + right * rng:NextNumber(-PATH_W / 2 + 0.3, PATH_W / 2 - 0.3)
		local d = rng:NextNumber(0.8, 2.2)
		layer += 1
		local patch = box("Patch", Vector3.new(0.04, d, d * rng:NextNumber(0.6, 1)),
			CFrame.new(p.X, 0.44 + (layer % 20) * 0.003, p.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0) * CFrame.Angles(0, 0, math.pi / 2),
			rng:NextInteger(1, 2) == 1 and DIRT_D or DIRT_L, Enum.Material.Ground, folder)
		patch.Shape, patch.CanCollide = Enum.PartType.Cylinder, false
	end

	for _ = 1, 12 do -- камушки по краям
		local side = rng:NextInteger(0, 1) == 0 and -1 or 1
		local p = dir * (r0 + rng:NextNumber(1, len - 3)) + right * side * rng:NextNumber(PATH_W / 2 - 0.5, PATH_W / 2 + 1.4)
		local s = rng:NextNumber(0.3, 0.7)
		ball("Pebble", s, Vector3.new(p.X, 0.15 + s / 3, p.Z), C3(125, 120, 112), Enum.Material.Slate, folder).CanCollide = false
	end
end

local plotsFolder = workspace:WaitForChild("Plots")
for i = 1, PLOTS do
	local plot = plotsFolder:WaitForChild("Plot" .. i, 10)
	if plot then buildPath(plot, i) end
end]]></ProtectedString>

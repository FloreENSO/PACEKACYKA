	<Item class="ServerScriptService" referent="RBX1B94D3B4CA1D48FB9CC17F1E261DC7DB">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">2dc683e6fd1b962a0b0b7796000003c1</UniqueId>
		</Properties>
		<Item class="Script" referent="RBXA3AD3EBA27304C35B111463D9836C658">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

-- Настройки
local PLOT_COUNT = 7
local PLOT_SIZE = 40        -- размер участка (студов)
local CIRCLE_RADIUS = 90    -- радиус круга, по которому стоят участки
local FENCE_HEIGHT = 4
local GATE_WIDTH = 8        -- ширина ворот

local GROUND_TOP = 1        -- высота верха платформы участка

-- Убираем стандартную точку появления из шаблона Baseplate
local defaultSpawn = workspace:FindFirstChildOfClass("SpawnLocation")
if defaultSpawn then
	defaultSpawn:Destroy()
end

local plotsFolder = Instance.new("Folder")
plotsFolder.Name = "Plots"
plotsFolder.Parent = workspace

local function makePart(name, size, cf, color, material, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local WOOD = Color3.fromRGB(139, 94, 60)

-- Кусок забора между двумя точками (координаты относительно участка)
local function buildFenceSegment(plotCF, a, b, parent)
	local worldA = plotCF:PointToWorldSpace(a)
	local worldB = plotCF:PointToWorldSpace(b)
	local length = (worldB - worldA).Magnitude
	if length < 0.1 then return end

	local mid = (worldA + worldB) / 2
	local segCF = CFrame.lookAt(mid, worldB)

	-- Две горизонтальные перекладины
	for _, h in ipairs({1.2, 3}) do
		makePart(
			"Rail",
			Vector3.new(0.4, 0.4, length),
			segCF * CFrame.new(0, h, 0),
			WOOD,
			Enum.Material.Wood,
			parent
		)
	end

	-- Столбики через каждые ~4 студа
	local postCount = math.floor(length / 4) + 1
	for i = 0, postCount do
		local t = i / postCount
		local pos = worldA:Lerp(worldB, t)
		makePart(
			"Post",
			Vector3.new(0.8, FENCE_HEIGHT, 0.8),
			CFrame.new(pos + Vector3.new(0, FENCE_HEIGHT / 2, 0)),
			WOOD,
			Enum.Material.Wood,
			parent
		)
	end
end

local plots = {}

-- Обновление таблички над воротами
local function updateSign(plot)
	if plot.owner then
		plot.nameLabel.Text = plot.owner.DisplayName
		plot.nameLabel.TextColor3 = Color3.fromRGB(40, 90, 30)
	else
		plot.nameLabel.Text = "Свободна"
		plot.nameLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
	end
end

for i = 1, PLOT_COUNT do
	local angle = (i - 1) * (2 * math.pi / PLOT_COUNT)
	local pos = Vector3.new(math.sin(angle) * CIRCLE_RADIUS, 0, math.cos(angle) * CIRCLE_RADIUS)

	-- Участок повёрнут передом (воротами) к центру
	local plotCF = CFrame.lookAt(pos, Vector3.new(0, 0, 0))

	local model = Instance.new("Model")
	model.Name = "Plot" .. i
	model.Parent = plotsFolder

	-- Земля участка
	makePart(
		"Ground",
		Vector3.new(PLOT_SIZE, 1, PLOT_SIZE),
		plotCF * CFrame.new(0, 0.5, 0),
		Color3.fromRGB(106, 190, 80),
		Enum.Material.Grass,
		model
	)

	-- Забор
	local fenceFolder = Instance.new("Folder")
	fenceFolder.Name = "Fence"
	fenceFolder.Parent = model

	local h = PLOT_SIZE / 2
	local fenceCF = plotCF * CFrame.new(0, GROUND_TOP, 0)
	local g = GATE_WIDTH / 2

	-- Передняя сторона (z = -h) с воротами посередине
	buildFenceSegment(fenceCF, Vector3.new(-h, 0, -h), Vector3.new(-g, 0, -h), fenceFolder)
	buildFenceSegment(fenceCF, Vector3.new(g, 0, -h), Vector3.new(h, 0, -h), fenceFolder)
	-- Правая, задняя, левая стороны
	buildFenceSegment(fenceCF, Vector3.new(h, 0, -h), Vector3.new(h, 0, h), fenceFolder)
	buildFenceSegment(fenceCF, Vector3.new(h, 0, h), Vector3.new(-h, 0, h), fenceFolder)
	buildFenceSegment(fenceCF, Vector3.new(-h, 0, h), Vector3.new(-h, 0, -h), fenceFolder)

	-- Точка появления игрока (на участке, ближе к воротам)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = plotCF * CFrame.new(0, GROUND_TOP + 0.5, -10)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 0.6
	spawn.Color = Color3.fromRGB(255, 200, 0)
	spawn.Parent = model

	-- Табличка над воротами
	local sign = makePart(
		"Sign",
		Vector3.new(12, 4, 0.5),
		fenceCF * CFrame.new(0, 8, -h),
		Color3.fromRGB(255, 220, 100),
		Enum.Material.Wood,
		model
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.Parent = sign

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.fromScale(1, 0.45)
	titleLabel.Position = UDim2.fromScale(0, 0.05)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "Пасека"
	titleLabel.TextScaled = true
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextColor3 = Color3.fromRGB(80, 50, 20)
	titleLabel.Parent = gui

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.fromScale(0.9, 0.4)
	nameLabel.Position = UDim2.fromScale(0.05, 0.52)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = "Свободна"
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
	nameLabel.Parent = gui

	plots[i] = {model = model, spawn = spawn, owner = nil, nameLabel = nameLabel}
end

-- Выдача случайного свободного участка
local function assignPlot(player)
	local freePlots = {}
	for _, plot in ipairs(plots) do
		if plot.owner == nil then
			table.insert(freePlots, plot)
		end
	end

	if #freePlots == 0 then
		player:Kick("Все пасеки заняты. Попробуйте зайти позже.")
		return false
	end

	local plot = freePlots[math.random(1, #freePlots)]
	plot.owner = player
	player.RespawnLocation = plot.spawn
	plot.model:SetAttribute("OwnerName", player.Name)
	player:SetAttribute("PlotIndex", table.find(plots, plot))
	updateSign(plot)
	return true
end

local function freePlot(player)
	for _, plot in ipairs(plots) do
		if plot.owner == player then
			plot.owner = nil
			plot.model:SetAttribute("OwnerName", nil)
			updateSign(plot)
		end
	end
end

Players.PlayerAdded:Connect(assignPlot)
Players.PlayerRemoving:Connect(freePlot)

-- На случай, если игрок уже в игре к моменту запуска скрипта
for _, player in ipairs(Players:GetPlayers()) do
	if assignPlot(player) and player.Character then
		player:LoadCharacter()
	end
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{C010E438-7ECD-4643-A5AC-B197FC1932E1}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Plots</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2dc683e6fd1b962a0b0b779600003652</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX937C85EBBA2342DC8704FFC98602F36B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local plotsFolder = workspace:WaitForChild("Plots")
local rng = Random.new()

local HONEY_COLORS = {
	Color3.fromRGB(255, 190, 40),
	Color3.fromRGB(255, 205, 75),
	Color3.fromRGB(240, 165, 25),
}

local FLOWER_COLORS = {
	Color3.fromRGB(255, 90, 110),
	Color3.fromRGB(255, 150, 200),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(170, 120, 255),
	Color3.fromRGB(255, 140, 50),
}

local function newPart(name, size, cf, color, material, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Шестиугольная медовая плитка (из трёх повёрнутых прямоугольников)
local function makeHex(cf, s, color, parent)
	for k = 0, 2 do
		newPart(
			"Hex",
			Vector3.new(2 * s, 0.15 + k * 0.01, s * math.sqrt(3)),
			cf * CFrame.Angles(0, math.rad(60 * k), 0) * CFrame.new(0, k * 0.005, 0),
			color,
			Enum.Material.SmoothPlastic,
			parent
		)
	end
end

-- Цветочек
local function makeFlower(cf, parent)
	local h = rng:NextNumber(0.8, 1.6)
	newPart("Stem", Vector3.new(0.15, h, 0.15), cf * CFrame.new(0, h / 2, 0),
		Color3.fromRGB(70, 150, 60), Enum.Material.Grass, parent)

	local petals = newPart("Petals", Vector3.new(0.8, 0.8, 0.8), cf * CFrame.new(0, h + 0.1, 0),
		FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], Enum.Material.SmoothPlastic, parent)
	petals.Shape = Enum.PartType.Ball

	local core = newPart("Core", Vector3.new(0.4, 0.4, 0.4), cf * CFrame.new(0, h + 0.4, 0),
		Color3.fromRGB(255, 200, 40), Enum.Material.SmoothPlastic, parent)
	core.Shape = Enum.PartType.Ball
end

local function decoratePlot(plot)
	local spawn = plot:WaitForChild("Spawn")

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = plot

	-- Уровень земли под точкой появления
	local base = spawn.CFrame * CFrame.new(0, -0.5, 0)

	-- Точка появления: тонкая светящаяся медовая площадка
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then decal:Destroy() end
	spawn.Size = Vector3.new(6, 0.4, 6)
	spawn.CFrame = base * CFrame.new(0, 0.2, 0)
	spawn.Color = Color3.fromRGB(255, 190, 40)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.15

	-- Золотые искорки над площадкой
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Rate = 6
	sparkles.Lifetime = NumberRange.new(2, 3)
	sparkles.Speed = NumberRange.new(1, 2)
	sparkles.EmissionDirection = Enum.NormalId.Top
	sparkles.SpreadAngle = Vector2.new(30, 30)
	sparkles.Acceleration = Vector3.new(0, 1, 0)
	sparkles.LightEmission = 1
	sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 220, 100))
	sparkles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkles.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	sparkles.Parent = spawn

	-- Мягкий тёплый свет
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 80)
	light.Brightness = 1.5
	light.Range = 14
	light.Parent = spawn

	-- Дорожка из медовых шестиугольников
	local s = 1.1
	local rowStep = s * math.sqrt(3)
	for col = -1, 1 do
		for row = -4, 4 do
			local z = row * rowStep + ((col % 2 ~= 0) and rowStep / 2 or 0)
			local tileCF = base * CFrame.new(col * 1.5 * s, 0.075, z)
			makeHex(tileCF, s * 0.93, HONEY_COLORS[rng:NextInteger(1, #HONEY_COLORS)], decor)
		end
	end

	-- Цветы по обе стороны от дорожки
	for i = 1, 16 do
		local side = (i % 2 == 0) and 1 or -1
		local x = side * rng:NextNumber(5.5, 16)
		local z = rng:NextNumber(-8, 8)
		makeFlower(base * CFrame.new(x, 0, z), decor)
	end
end

for _, plot in ipairs(plotsFolder:GetChildren()) do
	task.spawn(decoratePlot, plot)
end
plotsFolder.ChildAdded:Connect(function(plot)
	task.spawn(decoratePlot, plot)
end)

-- Вспышка медовых искр, когда игрок появляется
local function burst(character)
	local hrp = character:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Lifetime = NumberRange.new(0.8, 1.2)
	emitter.Speed = NumberRange.new(8, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3
	emitter.LightEmission = 1
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 210, 80))
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Parent = hrp
	emitter:Emit(30)
	Debris:AddItem(emitter, 3)
end

local function onPlayer(player)
	player.CharacterAdded:Connect(burst)
	if player.Character then
		task.spawn(burst, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayer(player)
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>

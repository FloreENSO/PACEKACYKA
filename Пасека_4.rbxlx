				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">FlowerSpawnArea</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">652430e78e5274de0b0b9142000016b6</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX85E0D0760075418BB4A89E5F98D71489">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local P = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local W = workspace
local RS = game:GetService("ReplicatedStorage")
local BeeData = require(RS:WaitForChild("BeeData"))

local T = {
	["Обычный"] = 5, ["Необычный"] = 8, ["Редкий"] = 12,
	["Эпический"] = 20, ["Легендарный"] = 35, ["Мифический"] = 60,
	["Божественный"] = 120, ["Небесный"] = 180,
	["Космический"] = 300, ["Трансцендентный"] = 600,
	["Алмазный"] = 900, ["Плазменный"] = 1200,
	["Галактический"] = 1800, ["Астральный"] = 2700,
	["Вечный"] = 3600,
}

local F = W:WaitForChild("Flowers")
local Bees = {}

-- === УЛУЧШЕНИЯ ИЗ МАГАЗИНА ИВАНА ===
-- Возвращает множители для конкретного игрока на текущий момент
local function getUpgradeMults(plr)
	local upg = plr:FindFirstChild("Upgrades")
	local lvl = function(id)
		local v = upg and upg:FindFirstChild(id)
		return v and v.Value or 0
	end
	return {
		flightSpeed = 16 * (1 + 0.05 * lvl("SpeedLevel")), -- +5% скорости за уровень
		timeMult = math.max(1 - 0.04 * lvl("TimeLevel"), 0.1), -- -4% времени за уровень
		mutMult = 1 + 0.03 * lvl("MutationLevel"), -- +3% к шансу мутации за уровень
	}
end

-- RemoteEvent открытия меню улья (клик/подход к улью)
local openMenuEvent = RS:FindFirstChild("OpenHiveMenu")
if not openMenuEvent then
	openMenuEvent = Instance.new("RemoteEvent")
	openMenuEvent.Name = "OpenHiveMenu"
	openMenuEvent.Parent = RS
end

-- RemoteEvent обновления UI ульев
local refreshUIEvent = RS:FindFirstChild("RefreshHiveUI")
if not refreshUIEvent then
	refreshUIEvent = Instance.new("RemoteEvent")
	refreshUIEvent.Name = "RefreshHiveUI"
	refreshUIEvent.Parent = RS
end

-- RemoteEvent сбора меда через меню улья
local collectHoneyEvent = RS:FindFirstChild("CollectHoneyFromHive")
if not collectHoneyEvent then
	collectHoneyEvent = Instance.new("RemoteEvent")
	collectHoneyEvent.Name = "CollectHoneyFromHive"
	collectHoneyEvent.Parent = RS
end

-- === УНИКАЛЬНЫЕ МОДЕЛЬКИ ПЧЕЛ (у каждой породы свой облик) ===
local function createBee(pos, beeInfo)
	local b = Instance.new("Model")
	b.Name = beeInfo.name

	local mk = function(name, size, cf, color, shape, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Shape = shape or Enum.PartType.Block
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CFrame = cf
		p.Parent = b
		return p
	end

	local isElite = beeInfo.mutationMultiplier > 20
	local bodyMat = isElite and Enum.Material.Neon or Enum.Material.SmoothPlastic

	-- голова с глазками и усиками
	local head = mk("Head", Vector3.new(0.85, 0.85, 0.85), CFrame.new(pos) * CFrame.new(0, 0.05, -1.0), Color3.fromRGB(35, 30, 25), Enum.PartType.Ball)
	mk("EyeL", Vector3.new(0.3, 0.34, 0.2), head.CFrame * CFrame.new(-0.24, 0.08, -0.33), Color3.new(1, 1, 1), Enum.PartType.Ball)
	mk("EyeR", Vector3.new(0.3, 0.34, 0.2), head.CFrame * CFrame.new(0.24, 0.08, -0.33), Color3.new(1, 1, 1), Enum.PartType.Ball)
	mk("PupilL", Vector3.new(0.14, 0.16, 0.1), head.CFrame * CFrame.new(-0.26, 0.08, -0.44), Color3.fromRGB(20, 20, 20), Enum.PartType.Ball)
	mk("PupilR", Vector3.new(0.14, 0.16, 0.1), head.CFrame * CFrame.new(0.26, 0.08, -0.44), Color3.fromRGB(20, 20, 20), Enum.PartType.Ball)
	for _, side in ipairs({-1, 1}) do
		local sn = side < 0 and "L" or "R"
		mk("Antenna" .. sn, Vector3.new(0.12, 0.12, 0.12), head.CFrame * CFrame.new(side * 0.2, 0.42, -0.18), Color3.fromRGB(35, 30, 25), Enum.PartType.Ball)
		mk("AntennaMid" .. sn, Vector3.new(0.1, 0.1, 0.1), head.CFrame * CFrame.new(side * 0.3, 0.6, -0.36), Color3.fromRGB(35, 30, 25), Enum.PartType.Ball)
		mk("AntennaTip" .. sn, Vector3.new(0.16, 0.16, 0.16), head.CFrame * CFrame.new(side * 0.38, 0.76, -0.5), Color3.fromRGB(25, 22, 20), Enum.PartType.Ball)
	end

	-- пушистая грудка
	local body = mk("Body", Vector3.new(1.15, 1.15, 1.15), CFrame.new(pos), beeInfo.color, Enum.PartType.Ball, bodyMat)

	-- цвет полосок
	local stripeColor = Color3.new(0.1, 0.1, 0.1)
	if beeInfo.color.R < 0.2 and beeInfo.color.G < 0.2 then
		stripeColor = Color3.new(0.9, 0.8, 0.1)
	end

	-- сегментированное брюшко (как у настоящей пчелы — чередование цвета и полос)
	local segs = {}
	local segData = {
		{z = 0.55,  s = 1.05, c = beeInfo.color},
		{z = 1.05, s = 0.92, c = stripeColor},
		{z = 1.5,  s = 0.78, c = beeInfo.color},
		{z = 1.85, s = 0.58, c = stripeColor},
	}
	for i, sd in ipairs(segData) do
		table.insert(segs, mk("Segment" .. i, Vector3.new(sd.s, sd.s, sd.s), body.CFrame * CFrame.new(0, 0, sd.z), sd.c, Enum.PartType.Ball, bodyMat))
	end

	-- жало
	mk("Stinger", Vector3.new(0.5, 0.28, 0.28), body.CFrame * CFrame.new(0, 0, 2.15) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(40, 38, 35), Enum.PartType.Cylinder)
	mk("StingerTip", Vector3.new(0.18, 0.18, 0.18), body.CFrame * CFrame.new(0, 0, 2.42), Color3.fromRGB(40, 38, 35), Enum.PartType.Ball)

	-- 6 лапок
	for _, side in ipairs({-1, 1}) do
		for i = 0, 2 do
			mk("Leg" .. (side < 0 and "L" or "R") .. (i + 1), Vector3.new(0.6, 0.09, 0.09),
				body.CFrame * CFrame.new(side * 0.55, -0.45, -0.25 + i * 0.45) * CFrame.Angles(0, 0, math.rad(-35 * side)),
				Color3.fromRGB(35, 30, 25), Enum.PartType.Cylinder)
		end
	end

	-- === декорации по породе ===
	local n = beeInfo.name
	if n == "Полевая" then
		-- цветок на спине
		mk("FlowerCenter", Vector3.new(0.35, 0.35, 0.2), body.CFrame * CFrame.new(0, 0.5, 0.3) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(255, 220, 60), Enum.PartType.Cylinder)
		for i = 0, 4 do
			local a = i / 5 * math.pi * 2
			mk("Petal" .. i, Vector3.new(0.3, 0.15, 0.25), body.CFrame * CFrame.new(math.cos(a) * 0.45, 0.5, 0.3 + math.sin(a) * 0.45) * CFrame.Angles(0, -a, 0), Color3.fromRGB(255, 245, 235))
		end
	elseif n == "Медная" then
		-- металлическая с заклёпками
		body.Material = Enum.Material.Metal
		head.Material = Enum.Material.Metal
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2
			mk("Rivet" .. i, Vector3.new(0.22, 0.22, 0.22), body.CFrame * CFrame.new(math.cos(a) * 0.7, 0.3, math.sin(a) * 0.7), Color3.fromRGB(90, 60, 40), Enum.PartType.Ball, Enum.Material.Metal)
		end
	elseif n == "Серебристая" then
		-- серебряные шипы
		for i = 1, 3 do
			mk("Spike" .. i, Vector3.new(0.18, 0.18, 0.7), body.CFrame * CFrame.new(-0.4 + (i - 1) * 0.4, 0.55, 0) * CFrame.Angles(math.rad(-25 + i * 10), 0, 0), Color3.fromRGB(230, 235, 245), Enum.PartType.Cylinder, Enum.Material.Metal)
		end
	elseif n == "Золотоносная" then
		-- золотая корона
		mk("CrownBase", Vector3.new(0.55, 0.12, 0.55), head.CFrame * CFrame.new(0, 0.5, 0), Color3.fromRGB(255, 200, 40))
		for i = 1, 3 do
			mk("CrownSpike" .. i, Vector3.new(0.12, 0.35, 0.12), head.CFrame * CFrame.new(-0.18 + (i - 1) * 0.18, 0.72, 0), Color3.fromRGB(255, 200, 40))
		end
		mk("Nugget", Vector3.new(0.3, 0.25, 0.3), body.CFrame * CFrame.new(0, 0.5, 0.3) * CFrame.Angles(0, math.rad(30), 0), Color3.fromRGB(255, 190, 60))
	elseif n == "Изумрудная" then
		-- кристаллы изумруда на спине
		for i = 1, 3 do
			mk("Crystal" .. i, Vector3.new(0.35, 0.65, 0.35), body.CFrame * CFrame.new(-0.45 + (i - 1) * 0.45, 0.6, 0.2) * CFrame.Angles(math.rad((i - 2) * 20), math.rad(35 * i), 0), Color3.fromRGB(60, 230, 140), Enum.PartType.Block, Enum.Material.Neon)
		end
	elseif n == "Рубиновая" then
		-- рубиновые самоцветы
		mk("GemTop", Vector3.new(0.45, 0.45, 0.45), body.CFrame * CFrame.new(0, 0.6, 0.2) * CFrame.Angles(math.rad(45), math.rad(45), 0), Color3.fromRGB(255, 40, 70), Enum.PartType.Ball, Enum.Material.Glass)
		mk("GemL", Vector3.new(0.2, 0.2, 0.2), head.CFrame * CFrame.new(-0.35, 0.2, 0), Color3.fromRGB(255, 40, 70), Enum.PartType.Ball, Enum.Material.Glass)
		mk("GemR", Vector3.new(0.2, 0.2, 0.2), head.CFrame * CFrame.new(0.35, 0.2, 0), Color3.fromRGB(255, 40, 70), Enum.PartType.Ball, Enum.Material.Glass)
	elseif n == "Сапфировая" then
		-- ледяные шипы
		for i = 1, 4 do
			mk("Icicle" .. i, Vector3.new(0.15, 0.15, 0.6), body.CFrame * CFrame.new(-0.5 + (i - 1) * 0.33, 0.55, 0.2 - (i % 2) * 0.3) * CFrame.Angles(math.rad(-30 + i * 12), 0, 0), Color3.fromRGB(180, 220, 255), Enum.PartType.Cylinder, Enum.Material.Glass)
		end
	elseif n == "Аметистовая" then
		-- гроздь аметистов
		for i = 1, 3 do
			mk("Amethyst" .. i, Vector3.new(0.3, 0.45, 0.3), body.CFrame * CFrame.new(-0.4 + (i - 1) * 0.4, 0.55 + (i % 2) * 0.15, 0.25) * CFrame.Angles(math.rad(15 * i), math.rad(40 * i), 0), Color3.fromRGB(190, 120, 255), Enum.PartType.Block, Enum.Material.Neon)
		end
	elseif n == "Янтарная" then
		-- янтарь с жуком внутри
		body.Material = Enum.Material.Glass
		body.Transparency = 0.25
		for _, s in ipairs(segs) do
			s.Material = Enum.Material.Glass
			s.Transparency = 0.25
		end
		mk("BugInAmber", Vector3.new(0.35, 0.25, 0.45), body.CFrame * CFrame.new(0, 0, 0.4), Color3.fromRGB(60, 40, 25), Enum.PartType.Ball)
	elseif n == "Бирюзовая" then
		-- плавники как у рыбки
		mk("FinL", Vector3.new(0.1, 0.7, 0.9), body.CFrame * CFrame.new(-0.85, 0.1, 0.2), Color3.fromRGB(120, 245, 255), Enum.PartType.Ball)
		mk("FinR", Vector3.new(0.1, 0.7, 0.9), body.CFrame * CFrame.new(0.85, 0.1, 0.2), Color3.fromRGB(120, 245, 255), Enum.PartType.Ball)
		mk("FinTop", Vector3.new(0.15, 0.6, 0.5), body.CFrame * CFrame.new(0, 0.6, 0.3), Color3.fromRGB(120, 245, 255), Enum.PartType.Wedge)
	elseif n == "Розовая" then
		-- бантик на голове
		mk("BowL", Vector3.new(0.35, 0.25, 0.12), head.CFrame * CFrame.new(-0.35, 0.55, 0), Color3.fromRGB(255, 90, 160), Enum.PartType.Ball)
		mk("BowR", Vector3.new(0.35, 0.25, 0.12), head.CFrame * CFrame.new(0.35, 0.55, 0), Color3.fromRGB(255, 90, 160), Enum.PartType.Ball)
		mk("BowKnot", Vector3.new(0.15, 0.15, 0.15), head.CFrame * CFrame.new(0, 0.55, 0), Color3.fromRGB(255, 60, 130), Enum.PartType.Ball)
		mk("HeartTail", Vector3.new(0.3, 0.3, 0.15), body.CFrame * CFrame.new(0, 0.4, 1.1), Color3.fromRGB(255, 90, 160), Enum.PartType.Ball)
	elseif n == "Обсидиановая" then
		-- острые чёрные лезвия
		for i = 1, 4 do
			mk("Blade" .. i, Vector3.new(0.28, 0.75, 0.28), body.CFrame * CFrame.new(-0.45 + (i - 1) * 0.3, 0.5, 0.3) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(25, 20, 40), Enum.PartType.Wedge)
		end
		mk("EyeGlow", Vector3.new(1, 0.15, 0.15), head.CFrame * CFrame.new(0, 0.15, -0.42), Color3.fromRGB(160, 135, 215), Enum.PartType.Ball, Enum.Material.Neon)
	elseif n == "Лунная" then
		-- сияющий нимб-полумесяц
		for i = 1, 8 do
			local a = i / 8 * math.pi * 2
			mk("Halo" .. i, Vector3.new(0.18, 0.18, 0.18), head.CFrame * CFrame.new(math.cos(a) * 0.6, 0.8, math.sin(a) * 0.6), Color3.fromRGB(240, 245, 255), Enum.PartType.Ball, Enum.Material.Neon)
		end
	elseif n == "Огненная" then
		-- языки пламени
		local flameColors = {Color3.fromRGB(255, 60, 10), Color3.fromRGB(255, 120, 20), Color3.fromRGB(255, 190, 40)}
		for i = 1, 3 do
			mk("Flame" .. i, Vector3.new(0.25, 0.25, 0.7), body.CFrame * CFrame.new(-0.4 + (i - 1) * 0.4, 0.6, -0.1) * CFrame.Angles(math.rad(70 + i * 10), 0, 0), flameColors[i], Enum.PartType.Cylinder, Enum.Material.Neon)
		end
	elseif n == "Космическая" then
		-- орбитальное кольцо из звёзд
		local starColors = {Color3.fromRGB(140, 90, 255), Color3.fromRGB(90, 160, 255), Color3.fromRGB(255, 255, 255)}
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			mk("Orbit" .. i, Vector3.new(0.22, 0.22, 0.22), body.CFrame * CFrame.new(math.cos(a) * 1.3, 0.2, math.sin(a) * 1.3), starColors[(i - 1) % 3 + 1], Enum.PartType.Ball, Enum.Material.Neon)
		end
		mk("Antenna", Vector3.new(0.1, 0.1, 0.5), head.CFrame * CFrame.new(0, 0.45, 0), Color3.fromRGB(200, 180, 255), Enum.PartType.Cylinder, Enum.Material.Neon)
		mk("AntennaStar", Vector3.new(0.2, 0.2, 0.2), head.CFrame * CFrame.new(0, 0.75, 0), Color3.fromRGB(255, 255, 255), Enum.PartType.Ball, Enum.Material.Neon)
	end

	-- крылья
	local wingColor = Color3.fromRGB(200, 240, 255)
	if beeInfo.mutationMultiplier > 10 then wingColor = beeInfo.color:Lerp(Color3.new(1,1,1), 0.5) end

	local wing1 = mk("Wing1", Vector3.new(1.0, 0.08, 1.5), body.CFrame * CFrame.new(-0.8, 0.55, -0.15), wingColor, Enum.PartType.Ball, Enum.Material.Glass)
	wing1.Transparency = 0.5
	local wing2 = wing1:Clone()
	wing2.Name = "Wing2"
	wing2.CFrame = body.CFrame * CFrame.new(0.8, 0.55, -0.15)
	wing2.Parent = b

	if beeInfo.rainbow then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Rate = 20
		emitter.Lifetime = NumberRange.new(0.5, 1)
		emitter.Speed = NumberRange.new(1, 2)
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		emitter.LightEmission = 1
		emitter.Parent = body

		task.spawn(function()
			while b.Parent do
				local c = Color3.fromHSV((os.clock() * 0.5) % 1, 0.8, 1)
				body.Color = c
				for _, s in ipairs(segs) do s.Color = c end
				task.wait(0.1)
			end
		end)
	elseif beeInfo.mutationMultiplier >= 20 then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Rate = 10
		emitter.Lifetime = NumberRange.new(0.8, 1.2)
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.Color = ColorSequence.new(beeInfo.color)
		emitter.LightEmission = 0.8
		emitter.Parent = body
	end

	local w1Base = wing1.CFrame
	local w2Base = wing2.CFrame
	task.spawn(function()
		while b.Parent do
			local rot = math.sin(os.clock() * 20) * 0.3
			wing1.CFrame = w1Base * CFrame.Angles(0, rot, 0)
			wing2.CFrame = w2Base * CFrame.Angles(0, -rot, 0)
			task.wait(0.03)
		end
	end)

	b.PrimaryPart = body
	b.Parent = W
	return b
end

-- === СОЗДАНИЕ УЛЬЯ С ПРАВИЛЬНЫМ ПОВОРОТОМ ===
local function createHiveModel(pos, lookAtPos)
	local hive = Instance.new("Model")
	hive.Name = "Hive"

	local lookDir = (lookAtPos - pos).Unit
	local angle = math.atan2(lookDir.X, lookDir.Z)

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Size = Vector3.new(4, 4, 4)
	base.CFrame = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
	base.Color = Color3.fromRGB(220, 145, 45)
	base.Material = Enum.Material.WoodPlanks
	base.Anchored = true
	base.CanCollide = true
	base.Parent = hive

	local roof = Instance.new("Part")
	roof.Name = "Roof"
	roof.Size = Vector3.new(5, 1, 5)
	roof.CFrame = base.CFrame * CFrame.new(0, 2.5, 0)
	roof.Color = Color3.fromRGB(120, 65, 25)
	roof.Material = Enum.Material.Wood
	roof.Anchored = true
	roof.Parent = hive

	local hole = Instance.new("Part")
	hole.Name = "Hole"
	hole.Size = Vector3.new(1.5, 0.5, 0.2)
	hole.CFrame = base.CFrame * CFrame.new(0, -0.5, 2)
	hole.Color = Color3.fromRGB(20, 20, 20)
	hole.Material = Enum.Material.SmoothPlastic
	hole.Anchored = true
	hole.Parent = hive

	hive.PrimaryPart = base
	hive.Parent = W
	return hive
end

local function part(parent, name, size, pos, color, shape)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position, p.Color, p.Shape = name, size, pos, color, shape or Enum.PartType.Block
	p.Anchored, p.CanCollide = true, false
	p.Parent = parent
	return p
end

local function fly(bee, pos, speed)
	if not bee or not bee.Parent then return end
	local start = bee:GetPivot().Position
	local dir = pos - start

	local cf = Instance.new("CFrameValue")
	cf.Value = bee:GetPivot()
	local conn = cf.Changed:Connect(function(v) if bee.Parent then bee:PivotTo(v) end end)

	-- быстрый доворот в сторону полёта (голова у пчелы на -Z)
	if dir.Magnitude > 0.01 then
		local faceCF = CFrame.lookAt(start, start + dir.Unit)
		local turn = TweenService:Create(cf, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Value = faceCF - faceCF.Position + cf.Value.Position})
		turn:Play()
		turn.Completed:Wait()
		if not bee.Parent then conn:Disconnect(); cf:Destroy(); return end
	end

	local targetCF
	if dir.Magnitude > 0.01 then
		targetCF = CFrame.lookAt(pos, pos + dir.Unit)
	else
		targetCF = CFrame.new(pos)
	end

	local tw = TweenService:Create(cf, TweenInfo.new(math.max(dir.Magnitude / (speed or 16), 0.3), Enum.EasingStyle.Linear), {Value = targetCF})
	tw:Play()
	tw.Completed:Wait()
	conn:Disconnect()
	cf:Destroy()
end

local function createTimer(hiveModel, textString, duration)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "TimerUI"
	billboard.Size = UDim2.fromOffset(200, 50)
	billboard.StudsOffset = Vector3.new(0, 5.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = hiveModel.PrimaryPart

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.fromRGB(255, 200, 50)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 18
	text.TextStrokeTransparency = 0
	text.Parent = billboard

	task.spawn(function()
		local timeLeft = duration
		while timeLeft > 0 and billboard.Parent do
			text.Text = textString .. ": " .. math.ceil(timeLeft) .. "с"
			task.wait(0.1)
			timeLeft -= 0.1
		end
		if billboard.Parent then billboard:Destroy() end
	end)
end

-- === МЕД ХРАНИТСЯ В УЛЕЕ И ЗАБИРАЕТСЯ ЧЕРЕЗ МЕНЮ ===
local function updateHoneyBillboard(plr, hiveIndex)
	local entryData = Bees[plr]
	local hiveModel = entryData and entryData.HiveModels and entryData.HiveModels[hiveIndex]
	local hiveData = plr:FindFirstChild("Hives") and plr.Hives:FindFirstChild("Hive" .. hiveIndex)
	if not hiveModel or not hiveModel.Parent or not hiveData then return end

	local total, lastColor = 0, nil
	for _, v in ipairs(hiveData:GetChildren()) do
		if v:IsA("IntValue") and v:GetAttribute("IsHoney") then
			total += v.Value
			lastColor = Color3.new(v:GetAttribute("ColorR") or 1, v:GetAttribute("ColorG") or 0.8, v:GetAttribute("ColorB") or 0.2)
		end
	end

	local bb = hiveModel.PrimaryPart:FindFirstChild("HoneyReadyUI")
	if total <= 0 then
		if bb then bb:Destroy() end
		return
	end

	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "HoneyReadyUI"
		bb.Size = UDim2.fromOffset(250, 100)
		bb.StudsOffset = Vector3.new(0, 5, 0)
		bb.AlwaysOnTop = true
		bb.Parent = hiveModel.PrimaryPart

		local icon = Instance.new("ImageLabel")
		icon.Name = "Icon"
		icon.Size = UDim2.fromOffset(70, 70)
		icon.Position = UDim2.new(0.5, 0, 0, 0)
		icon.AnchorPoint = Vector2.new(0.5, 0)
		icon.BackgroundTransparency = 1
		icon.Image = "rbxassetid://7067803446"
		icon.Parent = bb

		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.Size = UDim2.new(1, 0, 0, 20)
		text.Position = UDim2.new(0, 0, 1, -8)
		text.AnchorPoint = Vector2.new(0, 0.5)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.fromRGB(255, 220, 80)
		text.TextStrokeTransparency = 0
		text.Font = Enum.Font.GothamBold
		text.TextSize = 15
		text.Parent = bb
	end

	bb.Icon.ImageColor3 = lastColor or Color3.fromRGB(255, 200, 60)
	bb.Text.Text = "Мед готов: " .. total .. " (открой улей)"
end

local function addHoneyToHive(plr, hiveIndex, rarity, color, isMutated, mutName, beeInfo)
	local hivesFolder = plr:FindFirstChild("Hives")
	local hiveData = hivesFolder and hivesFolder:FindFirstChild("Hive" .. hiveIndex)
	if not hiveData then return end

	local cleanRarity = rarity:gsub(" мед", "")
	local honeyName = isMutated and (cleanRarity .. " мед (" .. mutName .. ")[" .. beeInfo.mutationMultiplier .. "]") or (cleanRarity .. " мед")
	local key = "Honey_" .. honeyName .. "_" .. math.floor(color.R * 1000) .. "_" .. math.floor(color.G * 1000) .. "_" .. math.floor(color.B * 1000)

	local entry = hiveData:FindFirstChild(key)
	if not entry then
		entry = Instance.new("IntValue")
		entry.Name = key
		entry:SetAttribute("IsHoney", true)
		entry:SetAttribute("Rarity", cleanRarity)
		entry:SetAttribute("HoneyName", honeyName)
		entry:SetAttribute("ColorR", color.R)
		entry:SetAttribute("ColorG", color.G)
		entry:SetAttribute("ColorB", color.B)
		entry:SetAttribute("Mutated", isMutated == true)
		entry:SetAttribute("MutName", isMutated and mutName or "")
		entry.Parent = hiveData
	end
	entry.Value += 1

	updateHoneyBillboard(plr, hiveIndex)

	local refreshUI = RS:FindFirstChild("RefreshHiveUI")
	if refreshUI then refreshUI:FireClient(plr) end
end

local function spawnBeeForHive(plr, hiveModel, slotIndex, beeName, hiveIndex)
	local beeInfo = nil
	for _, info in ipairs(BeeData) do
		if info.name == beeName then beeInfo = info; break end
	end
	if not beeInfo then return end

	local spawnPos = (hiveModel.Hole.CFrame * CFrame.new(0, 0.5, 1.5)).Position
	local bee = createBee(spawnPos, beeInfo)
	table.insert(Bees[plr].Bees, bee)

	-- отслеживаем состав улья (для удаления пчёл и показа в UI)
	if hiveIndex then
		Bees[plr].HiveBees[hiveIndex] = Bees[plr].HiveBees[hiveIndex] or {}
		table.insert(Bees[plr].HiveBees[hiveIndex], {model = bee, name = beeName})

		local hiveData = plr:FindFirstChild("Hives") and plr.Hives:FindFirstChild("Hive" .. hiveIndex)
		if hiveData then
			local comp = hiveData:FindFirstChild(beeName)
			if not comp then
				comp = Instance.new("IntValue")
				comp.Name = beeName
				comp.Parent = hiveData
			end
			comp.Value += 1
		end
	end

	task.spawn(function()
		while plr.Parent and bee.Parent and hiveModel.Parent do
			local mults = getUpgradeMults(plr)
			local target, nearest = nil, math.huge
			for _, f in ipairs(F:GetChildren()) do
				local c = f:FindFirstChild("Center")
				if c and not f:GetAttribute("Busy") then
					local d = (c.Position - bee:GetPivot().Position).Magnitude
					if d < nearest then target, nearest = f, d end
				end
			end

			if target then
				local c = target:FindFirstChild("Center")
				target:SetAttribute("Busy", true)
				local rarity = target:GetAttribute("Rarity") or "Обычный"
				local color = c.Color

				fly(bee, c.Position + Vector3.new(0, 2, 0), mults.flightSpeed)
				if not plr.Parent or not bee.Parent then break end

				target:Destroy()

				fly(bee, (hiveModel.Hole.CFrame * CFrame.new(0, 0.5, 1.5)).Position, mults.flightSpeed)
				if not plr.Parent or not bee.Parent then break end

				local isMutated = false
				if math.random() * 100 <= beeInfo.mutationChance * mults.mutMult then
					isMutated = true
				end

				local duration = (T[rarity] or 5) * mults.timeMult
				local mutName = beeInfo.mutationName .. " мутация"
				local timerText = isMutated and ("Мутация: " .. mutName) or rarity
				createTimer(hiveModel, timerText, duration)

				task.wait(duration)

				if plr.Parent and bee.Parent and hiveModel.Parent then
					addHoneyToHive(plr, hiveIndex, rarity, color, isMutated, mutName, beeInfo)
				end
			else
				fly(bee, (hiveModel.Hole.CFrame * CFrame.new(0, 0.5, 1.5)).Position, mults.flightSpeed)
				task.wait(2)
			end
			task.wait(0.3)
		end
	end)
end

-- === НОВАЯ РАССТАНОВКА: ДВА РЯДА ===
local function buildHive(plr, ground, index)
	local hiveName = plr.Name .. "_Hive_" .. index
	local hiveModel = Bees[plr].HiveModels[index]

	if hiveModel and hiveModel.Parent then return end

	-- Логика рядов:
	-- Индексы 1-4 будут слева, 5-8 справа.
	local isLeftSide = index <= 4
	local rowIndex = isLeftSide and index or (index - 4)

	-- X: -12 для левого ряда, +12 для правого
	local xOffset = isLeftSide and -12 or 12

	-- Z: отступаем от заднего забора (начинаем с 6 и идем вперед через каждые 6 студов)
	local zOffset = 6 - (rowIndex - 1) * 6

	-- Координаты относительно центра участка
	local localOffset = Vector3.new(xOffset, 2.5, zOffset)
	local pos = (ground.CFrame * CFrame.new(localOffset)).Position

	-- Точка, на которую смотрит леток (центр коридора)
	local lookAtPos = (ground.CFrame * CFrame.new(0, 2.5, zOffset)).Position

	hiveModel = createHiveModel(pos, lookAtPos)
	hiveModel.Name = hiveName
	Bees[plr].HiveModels[index] = hiveModel

	-- взаимодействие с ульём: клик или E открывает меню управления пчёлами
	local function openMenu(player)
		if player == plr then
			openMenuEvent:FireClient(player, index)
		end
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Открыть улей"
	prompt.ObjectText = "Улей №" .. index
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = hiveModel.PrimaryPart
	prompt.Triggered:Connect(openMenu)
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 20
	click.Parent = hiveModel.PrimaryPart
	click.MouseClick:Connect(openMenu)

	local hiveData = plr.Hives:FindFirstChild("Hive" .. index)
	if hiveData then
		local count = hiveData.Value
		local beeNames = {}

		local beesFolder = plr:FindFirstChild("Bees")
		if beesFolder then
			for _, b in ipairs(BeeData) do
				local owned = beesFolder:FindFirstChild(b.name)
				if owned and owned.Value > 0 then
					table.insert(beeNames, b.name)
				end
			end
		end

		for slot = 1, count do
			local chosenName = beeNames[slot] or (BeeData[1] and BeeData[1].name)
			if chosenName then
				spawnBeeForHive(plr, hiveModel, slot, chosenName, index)
			end
		end
	end
end

local function updateHives(plr, root, plotGround, onlyNewIndex)
	local hivesFolder = plr:FindFirstChild("Hives")
	if not hivesFolder then return end

	local count = 0
	for _, v in ipairs(hivesFolder:GetChildren()) do count += 1 end

	if onlyNewIndex then
		buildHive(plr, plotGround, onlyNewIndex)
	else
		for i = 1, count do buildHive(plr, plotGround, i) end
	end
end

local function setup(plr)
	if Bees[plr] then return end
	Bees[plr] = {Bees = {}, HiveModels = {}, HiveBees = {}}

	local char = plr.Character or plr.CharacterAdded:Wait()
	local root = char:WaitForChild("HumanoidRootPart")

	local honey = plr:FindFirstChild("Honey")
	if not honey then
		honey = Instance.new("Folder")
		honey.Name = "Honey"
		honey.Parent = plr
	end

	local plotIdx = plr:GetAttribute("PlotIndex")
	local plot = plotIdx and W.Plots:FindFirstChild("Plot" .. plotIdx)
	local ground = plot and plot:FindFirstChild("Ground")

	if ground then updateHives(plr, root, ground) end
end

local updateBindable = RS:FindFirstChild("UpdateHivesBindable")
if not updateBindable then
	updateBindable = Instance.new("BindableEvent")
	updateBindable.Name = "UpdateHivesBindable"
	updateBindable.Parent = RS
end

updateBindable.Event:Connect(function(plr, hiveNum)
	local plotIdx = plr:GetAttribute("PlotIndex")
	local plot = plotIdx and W.Plots:FindFirstChild("Plot" .. plotIdx)
	local ground = plot and plot:FindFirstChild("Ground")
	if ground and plr.Character then 
		updateHives(plr, plr.Character.HumanoidRootPart, ground, hiveNum) 
	end
end)

local addBeeFn = RS:FindFirstChild("AddBeeToHive")
if not addBeeFn then
	addBeeFn = Instance.new("RemoteFunction")
	addBeeFn.Name = "AddBeeToHive"
	addBeeFn.Parent = RS
end

addBeeFn.OnServerInvoke = function(plr, hiveIndex, beeName)
	local hivesFolder = plr:FindFirstChild("Hives")
	local beesFolder = plr:FindFirstChild("Bees")
	if not hivesFolder or not beesFolder then return false, "Ошибка данных" end

	local hiveData = hivesFolder:FindFirstChild("Hive" .. hiveIndex)
	local ownedBee = beesFolder:FindFirstChild(beeName)

	if not hiveData or not ownedBee then return false, "Ошибка" end
	if hiveData.Value >= 5 then return false, "В улье уже 5 пчел!" end
	if ownedBee.Value <= 0 then return false, "У вас нет такой пчелы!" end

	ownedBee.Value -= 1
	hiveData.Value += 1

	local plotIdx = plr:GetAttribute("PlotIndex")
	local plot = plotIdx and W.Plots:FindFirstChild("Plot" .. plotIdx)
	local ground = plot and plot:FindFirstChild("Ground")

	if ground and Bees[plr] then
		local hiveModel = Bees[plr].HiveModels[hiveIndex]
		if hiveModel and hiveModel.Parent then
			spawnBeeForHive(plr, hiveModel, hiveData.Value, beeName, hiveIndex)
		end
	end

	local refreshUI = RS:FindFirstChild("RefreshHiveUI")
	if refreshUI then refreshUI:FireClient(plr) end

	return true, "Пчела посажена в улей!"
end

local function removeBeeFnSetup()

-- Сбор меда через меню улья
local collectEvent = RS:FindFirstChild("CollectHoneyFromHive")
if not collectEvent then
	collectEvent = Instance.new("RemoteEvent")
	collectEvent.Name = "CollectHoneyFromHive"
	collectEvent.Parent = RS
end

collectEvent.OnServerEvent:Connect(function(plr, hiveIndex, entryName)
	if type(hiveIndex) ~= "number" then return end
	local hivesFolder = plr:FindFirstChild("Hives")
	local honey = plr:FindFirstChild("Honey")
	if not hivesFolder or not honey then return end

	local hiveData = hivesFolder:FindFirstChild("Hive" .. hiveIndex)
	if not hiveData then return end

	local entries = {}
	if type(entryName) == "string" then
		local e = hiveData:FindFirstChild(entryName)
		if e and e:IsA("IntValue") and e:GetAttribute("IsHoney") then
			table.insert(entries, e)
		end
	else
		for _, v in ipairs(hiveData:GetChildren()) do
			if v:IsA("IntValue") and v:GetAttribute("IsHoney") then
				table.insert(entries, v)
			end
		end
	end

	for _, e in ipairs(entries) do
		local honeyName = e:GetAttribute("HoneyName")
		if honeyName and honeyName ~= "" then
			local v = honey:FindFirstChild(honeyName)
			if not v then
				v = Instance.new("IntValue")
				v.Name = honeyName
				v.Parent = honey
			end
			v.Value += e.Value
		end
		e:Destroy()
	end

	if #entries > 0 then
		updateHoneyBillboard(plr, hiveIndex)
		local refreshUI = RS:FindFirstChild("RefreshHiveUI")
		if refreshUI then refreshUI:FireClient(plr) end
	end
end)
	local removeBeeFn = RS:FindFirstChild("RemoveBeeFromHive")
	if not removeBeeFn then
		removeBeeFn = Instance.new("RemoteFunction")
		removeBeeFn.Name = "RemoveBeeFromHive"
		removeBeeFn.Parent = RS
	end

	removeBeeFn.OnServerInvoke = function(plr, hiveIndex, beeName)
		if type(hiveIndex) ~= "number" or type(beeName) ~= "string" then return false, "Ошибка данных" end
		local hivesFolder = plr:FindFirstChild("Hives")
		local beesFolder = plr:FindFirstChild("Bees")
		if not hivesFolder or not beesFolder then return false, "Ошибка данных" end

		local hiveData = hivesFolder:FindFirstChild("Hive" .. hiveIndex)
		local ownedBee = beesFolder:FindFirstChild(beeName)
		if not hiveData or not ownedBee then return false, "Ошибка" end
		if hiveData.Value <= 0 then return false, "Улей пуст!" end
		if not Bees[plr] or not Bees[plr].HiveBees then return false, "Ошибка данных" end

		-- ищем пчелу этого вида в улье
		local entry
		local hiveBees = Bees[plr].HiveBees and Bees[plr].HiveBees[hiveIndex]
		if hiveBees then
			for i, e in ipairs(hiveBees) do
				if e.name == beeName then
					entry = e
					table.remove(hiveBees, i)
					break
				end
			end
		end
		if not entry then return false, "В улье нет такой пчелы!" end

		if entry.model then entry.model:Destroy() end

		hiveData.Value -= 1
		ownedBee.Value += 1

		local comp = hiveData:FindFirstChild(beeName)
		if comp then
			comp.Value -= 1
			if comp.Value <= 0 then comp:Destroy() end
		end

		local refreshUI = RS:FindFirstChild("RefreshHiveUI")
		if refreshUI then refreshUI:FireClient(plr) end

		return true, "Пчела убрана из уля!"
	end
end
removeBeeFnSetup()

P.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(1)
		setup(plr)
	end)
end)

P.PlayerRemoving:Connect(function(plr)
	local d = Bees[plr]
	if d then
		for _, b in ipairs(d.Bees) do if b then b:Destroy() end end
		for _, h in pairs(d.HiveModels) do if h then h:Destroy() end end
	end
	Bees[plr] = nil
end)

for _, plr in ipairs(P:GetPlayers()) do task.spawn(setup, plr) end
print("BeeSystem (Двумя рядами по твоему эскизу) запущен!")

P.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(1)
		setup(plr)
	end)
end)

P.PlayerRemoving:Connect(function(plr)
	local d = Bees[plr]
	if d then
		for _, b in ipairs(d.Bees) do if b then b:Destroy() end end
		for _, h in pairs(d.HiveModels) do if h then h:Destroy() end end
	end
	Bees[plr] = nil
end)

for _, plr in ipairs(P:GetPlayers()) do task.spawn(setup, plr) end
print("BeeSystem (Двумя рядами по твоему эскизу) запущен!")]]></ProtectedString>

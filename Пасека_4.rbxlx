		<Item class="Script" referent="RBXC68F74590A784A629A9298C1CA473C5A">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local BeeData = require(RS:WaitForChild("BeeData"))

local START_COINS = 100000
local MAX_DISTANCE = 60

local openEvent = Instance.new("RemoteEvent")
openEvent.Name = "OpenIvanShop"
openEvent.Parent = RS

local buyFn = Instance.new("RemoteFunction")
buyFn.Name = "BuyBee"
buyFn.Parent = RS

local sellFn = Instance.new("RemoteFunction")
sellFn.Name = "SellHoney"
sellFn.Parent = RS

local buyUpgFn = Instance.new("RemoteFunction")
buyUpgFn.Name = "BuyUpgrade"
buyUpgFn.Parent = RS

-- Конфиг улучшений (должен совпадать с клиентом)
local UPGRADES = {
	{ id = "SpeedLevel", name = "Скорость пчёл", base = 10000, growth = 1.6, max = 25, step = 5, desc = "к скорости полёта" },
	{ id = "TimeLevel", name = "Скорость переработки", base = 25000, growth = 1.6, max = 25, step = 4, desc = "меньше времени на мёд" },
	{ id = "PriceLevel", name = "Цена мёда", base = 50000, growth = 1.6, max = 25, step = 7, desc = "к цене любого мёда" },
	{ id = "MutationLevel", name = "Шанс мутации", base = 100000, growth = 1.6, max = 25, step = 3, desc = "к шансу мутации" },
}

-- Базовые цены (без учета множителей мутаций)
local HONEY_PRICES = {
	["Обычный"] = 30, ["Необычный"] = 75, ["Редкий"] = 200,
	["Эпический"] = 600, ["Легендарный"] = 1500, ["Мифический"] = 4000,
	["Божественный"] = 10000, ["Небесный"] = 25000, ["Космический"] = 60000,
	["Трансцендентный"] = 150000,
	["Алмазный"] = 1000000, ["Плазменный"] = 10000000,
	["Галактический"] = 1000000000, ["Астральный"] = 10000000000,
	["Вечный"] = 100000000000,
}

local shopPos = Vector3.new(0, 0, 0)
local last = {}

local function setup(player)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end

	local coins = ls:FindFirstChild("Монеты")
	if not coins then
		coins = Instance.new("IntValue")
		coins.Name = "Монеты"
		coins.Value = START_COINS
		coins.Parent = ls
	end

	local bees = player:FindFirstChild("Bees")
	if not bees then
		bees = Instance.new("Folder")
		bees.Name = "Bees"
		bees.Parent = player
		for _, b in ipairs(BeeData) do
			local v = Instance.new("IntValue")
			v.Name = b.name
			v.Parent = bees
		end
	end

	local honey = player:FindFirstChild("Honey")
	if not honey then
		honey = Instance.new("Folder")
		honey.Name = "Honey"
		honey.Parent = player
	end

	local upg = player:FindFirstChild("Upgrades")
	if not upg then
		upg = Instance.new("Folder")
		upg.Name = "Upgrades"
		upg.Parent = player
		for _, u in ipairs(UPGRADES) do
			local v = Instance.new("IntValue")
			v.Name = u.id
			v.Parent = upg
		end
	end
end

Players.PlayerAdded:Connect(setup)
for _, p in ipairs(Players:GetPlayers()) do setup(p) end
Players.PlayerRemoving:Connect(function(p) last[p] = nil end)

-- Покупка пчел
buyFn.OnServerInvoke = function(player, index)
	if type(index) ~= "number" or index % 1 ~= 0 then return false, "Ошибка" end
	local bee = BeeData[index]
	if not bee then return false, "Такой пчелы нет" end

	if os.clock() - (last[player] or 0) < 0.3 then return false, "Не так быстро" end
	last[player] = os.clock()

	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - shopPos).Magnitude > MAX_DISTANCE then
		return false, "Подойдите к Ивану"
	end

	local ls = player:FindFirstChild("leaderstats")
	local coins = ls and ls:FindFirstChild("Монеты")
	local owned = player:FindFirstChild("Bees") and player.Bees:FindFirstChild(bee.name)
	if not coins or not owned then return false, "Данные ещё не загрузились" end

	if coins.Value < bee.price then return false, "Не хватает монет" end

	coins.Value -= bee.price
	owned.Value += 1
	return true, "Куплена: " .. bee.name .. " пчела!"
end

-- Продажа меда (учитывает скрытые множители)
sellFn.OnServerInvoke = function(player, honeyName, amount)
	if type(honeyName) ~= "string" or type(amount) ~= "number" or amount <= 0 then 
		return false, "Ошибка данных" 
	end

	-- 1. Вытаскиваем множитель из квадратных скобок (например, [1.35])
	local multiplierMatch = honeyName:match("%[(.-)%]")
	local multiplier = multiplierMatch and tonumber(multiplierMatch) or 1.0

	-- 2. Очищаем название от квадратных скобок и пробелов в конце
	local cleanName = honeyName:gsub("%[.-%]", ""):gsub("%s+$", "")

	-- 3. Находим базовую редкость (убираем " мед" и всё, что в круглых скобках)
	local baseRarity = cleanName:gsub(" мед", ""):gsub("%s*%(.*%)", "")

	local basePrice = HONEY_PRICES[baseRarity]
	if not basePrice then 
		return false, "Такого меда нет в базе (" .. baseRarity .. ")" 
	end

	-- Множитель цены от улучшений
	local upgF = player:FindFirstChild("Upgrades")
	local priceLvl = upgF and upgF:FindFirstChild("PriceLevel")
	local priceMult = 1 + 0.07 * (priceLvl and priceLvl.Value or 0)

	local finalPrice = math.floor(basePrice * multiplier * priceMult)

	if os.clock() - (last[player] or 0) < 0.3 then return false, "Не так быстро" end
	last[player] = os.clock()

	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - shopPos).Magnitude > MAX_DISTANCE then
		return false, "Подойдите к Ивану"
	end

	local ls = player:FindFirstChild("leaderstats")
	local coins = ls and ls:FindFirstChild("Монеты")
	local honeyFolder = player:FindFirstChild("Honey")
	local honeyVal = honeyFolder and honeyFolder:FindFirstChild(honeyName)

	if not coins or not honeyVal then return false, "Данные ещё не загрузились" end
	if honeyVal.Value < amount then return false, "У вас нет столько меда" end

	-- Сделка
	honeyVal.Value -= amount
	coins.Value += finalPrice * amount
	return true, "Продано " .. amount .. " шт. за " .. (finalPrice * amount) .. " монет!"
end

-- Покупка улучшений
buyUpgFn.OnServerInvoke = function(player, upgradeId)
	if type(upgradeId) ~= "string" then return false, "Ошибка данных" end

	local cfg
	for _, u in ipairs(UPGRADES) do
		if u.id == upgradeId then cfg = u break end
	end
	if not cfg then return false, "Такого улучшения нет" end

	if os.clock() - (last[player] or 0) < 0.3 then return false, "Не так быстро" end
	last[player] = os.clock()

	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - shopPos).Magnitude > MAX_DISTANCE then
		return false, "Подойдите к Ивану"
	end

	local upgF = player:FindFirstChild("Upgrades")
	local lvlVal = upgF and upgF:FindFirstChild(cfg.id)
	if not lvlVal then return false, "Данные ещё не загрузились" end

	if lvlVal.Value >= cfg.max then return false, "Уже максимальный уровень!" end

	local cost = math.floor(cfg.base * cfg.growth ^ lvlVal.Value)
	local ls = player:FindFirstChild("leaderstats")
	local coins = ls and ls:FindFirstChild("Монеты")
	if not coins then return false, "Данные ещё не загрузились" end

	if coins.Value < cost then return false, "Не хватает монет (нужно " .. cost .. ")" end

	coins.Value -= cost
	lvlVal.Value += 1
	return true, cfg.name .. " улучшено до ур. " .. lvlVal.Value .. "!"
end

-- Привязка кнопки к Ивану
task.spawn(function()
	local shop = workspace:WaitForChild("Hub"):WaitForChild("BeekeeperShop")
	local counter = shop:WaitForChild("CounterTop")
	shopPos = counter.Position

	local old = counter:FindFirstChild("ProximityPrompt", 30)
	if old then old:Destroy() end

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Открыть магазин"
	prompt.ObjectText = "Пчеловод Иван"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter
	prompt.Triggered:Connect(function(player)
		openEvent:FireClient(player)
	end)

	local ivan = shop:WaitForChild("Ivan", 30)
	if ivan then
		for _, part in ipairs(ivan:GetDescendants()) do
			if part:IsA("BasePart") then
				local cd = Instance.new("ClickDetector")
				cd.MaxActivationDistance = 30
				cd.Parent = part
				cd.MouseClick:Connect(function(player)
					openEvent:FireClient(player)
				end)
			end
		end
	end
end)]]></ProtectedString>

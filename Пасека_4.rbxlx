		<Item class="Script" referent="RBXB2522A5B6A724F6E88DB56587E61BB20">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local W, R = workspace, Random.new()
local RS = game:GetService("ReplicatedStorage")

-- RemoteEvent оповещения о редком цветке
local rareEvent = RS:FindFirstChild("RareFlowerSpawned")
if not rareEvent then
	rareEvent = Instance.new("RemoteEvent")
	rareEvent.Name = "RareFlowerSpawned"
	rareEvent.Parent = RS
end
-- МАКСИМУМ ЦВЕТОВ ТЕПЕРЬ 75 (вместо 60)
local MAX, IN, OUT, BANDS, TUFTS, TOP = 75, 122, 190, 4, 6000, 0.5  

local old = W:FindFirstChild("FlowerField")   
if old then old:Destroy() end

local lawn = Instance.new("Folder")
lawn.Name, lawn.Parent = "Lawn", W

-- Очищаем папку Flowers от старых цветов при перезапуске
local folder = W:FindFirstChild("Flowers")
if folder then
	folder:ClearAllChildren()
else
	folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Flowers", W
end

local function mk(parent, size, cf, color, mat, ball, solid)
	local p = Instance.new("Part")
	p.Size, p.CFrame, p.Color, p.Material = size, cf, color, mat or Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, solid or false, solid or false, false, solid or false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if ball then p.Shape = Enum.PartType.Ball end
	p.Parent = parent
	return p
end

local function ringPoint(margin)
	local a, r = R:NextNumber(0, 2 * math.pi), math.sqrt(R:NextNumber((IN + margin) ^ 2, (OUT - margin) ^ 2))
	return Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
end

-- Газон: кольцо из плиток, полосы двух оттенков
local greens = {Color3.fromRGB(88, 168, 66), Color3.fromRGB(104, 186, 78)}
local depth = (OUT - IN) / BANDS
for b = 1, BANDS do
	local ro = IN + b * depth
	local n = math.ceil(2 * math.pi * ro / 16)
	local step = 2 * math.pi / n
	for i = 0, n - 1 do
		local dir = Vector3.new(math.sin(i * step), 0, math.cos(i * step))
		local pos = dir * (ro - depth / 2) + Vector3.new(0, b * 0.002, 0)
		mk(lawn, Vector3.new(2 * ro * math.tan(step / 2) * 1.03, 1, depth), CFrame.lookAt(pos, pos + dir),
			greens[b % 2 + 1], Enum.Material.Grass, false, true)
	end
end

-- Пучки травы
for _ = 1, TUFTS do
	local p, h = ringPoint(1), R:NextNumber(0.8, 1.6)
	local color = Color3.fromRGB(R:NextInteger(60, 110), R:NextInteger(150, 205), R:NextInteger(50, 85))
	local yaw, lean = R:NextNumber(0, math.pi), math.rad(R:NextNumber(-12, 12))
	for k = 0, 2 do
		mk(lawn, Vector3.new(0.12, h, 0.8), CFrame.new(p.X, TOP + h / 2 - 0.05, p.Z) * CFrame.Angles(0, yaw + k * math.pi / 2, lean),
			color, Enum.Material.Grass)
	end
end

-- Цветы: {название, редкость, пыльца, шанс из 10000, цвет}
local F = {
	{"Одуванчик", "Обычный", 1, 6000, Color3.fromRGB(255, 230, 50)},
	{"Клевер", "Необычный", 2, 2000, Color3.fromRGB(50, 220, 90)},
	{"Ромашка", "Редкий", 5, 1000, Color3.fromRGB(60, 160, 255)},
	{"Кристальный", "Эпический", 10, 500, Color3.fromRGB(180, 60, 255)},
	{"Золотой", "Легендарный", 25, 250, Color3.fromRGB(255, 160, 20)},
	{"Мифический", "Мифический", 50, 150, Color3.fromRGB(255, 40, 100)},
	{"Божественный", "Божественный", 100, 60, Color3.fromRGB(255, 255, 255)},
	{"Небесный", "Небесный", 200, 25, Color3.fromRGB(0, 220, 255)},
	{"Космический", "Космический", 500, 14, Color3.fromRGB(100, 40, 255)},
	{"Трансцендентный", "Трансцендентный", 1000, 1, Color3.fromRGB(255, 0, 200)},
}

-- === РЕДКИЕ ЦВЕТЫ ГОРНОГО СКЛОНА ===
-- {название, редкость, пыльца/цена, шанс %, цвет}
local RARE = {
	{"Алмазный",      "Алмазный",      1000000,     1,       Color3.fromRGB(170, 220, 255)},
	{"Плазменный",    "Плазменный",    10000000,    0.1,     Color3.fromRGB(255, 60, 200)},
	{"Галактический", "Галактический", 1000000000,   0.001,   Color3.fromRGB(130, 60, 255)},
	{"Астральный",    "Астральный",    10000000000,  0.0001,  Color3.fromRGB(0, 255, 220)},
	{"Вечный",        "Вечный",        100000000000, 0.000001, Color3.fromRGB(255, 215, 0)},
}
local RARE_MAX = 10 -- всего 10 редких цветов на всю карту
local SLOPE_IN, SLOPE_OUT = 260, 700 -- кольцо горного склона

local function countRare()
	local n = 0
	for _, f in ipairs(folder:GetChildren()) do
		if f:GetAttribute("RareFlower") then n += 1 end
	end
	return n
end

local function fmtChance(x)
	return (string.format("%.6f", x):gsub("0+$", ""):gsub("%.$", ""))
end

local function spawnRareFlower(d)
	-- случайная точка на склоне горы (рейкаст вниз по террейну)
	local a = R:NextNumber(0, 2 * math.pi)
	local r = math.sqrt(R:NextNumber(SLOPE_IN ^ 2, SLOPE_OUT ^ 2))
	local origin = Vector3.new(math.sin(a) * r, 500, math.cos(a) * r)
	local hit = workspace:Raycast(origin, Vector3.new(0, -1000, 0))
	if not hit then return end
	local h = hit.Position.Y
	if h < 15 or h > 250 then return end -- только склон, не долина и не вершина

	local p = hit.Position + Vector3.new(0, 0.05, 0)
	local m = Instance.new("Model")
	m.Name = d[1]

	-- крупный светящийся цветок
	local c = mk(m, Vector3.new(1, 1, 1), CFrame.new(p + Vector3.new(0, 3, 0)), d[5], Enum.Material.Neon, true)
	c.Name = "Center"
	mk(m, Vector3.new(0.35, 3, 0.35), CFrame.new(p + Vector3.new(0, 1.5, 0)), Color3.fromRGB(40, 150, 50))
	for i = 1, 7 do
		local pa = math.rad(i * 51.4)
		mk(m, Vector3.new(1.1, 0.45, 1.1), CFrame.new(c.Position + Vector3.new(math.cos(pa) * 0.9, 0, math.sin(pa) * 0.9)), d[5], Enum.Material.Neon, true)
	end

	m.PrimaryPart = c
	m:SetAttribute("Rarity", d[2])
	m:SetAttribute("PollenAmount", d[3])
	m:SetAttribute("PollenType", d[2] .. " пыльца")
	m:SetAttribute("RareFlower", true)
	m:SetAttribute("SpawnChance", d[4])

	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.AlwaysOnTop, g.MaxDistance, g.Parent = UDim2.fromOffset(260, 70), Vector3.new(0, 3, 0), true, 250, c
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.TextScaled, t.Font = UDim2.fromScale(1, 1), 1, true, Enum.Font.GothamBold
	t.Text, t.TextColor3, t.TextStrokeTransparency, t.Parent = d[1] .. "\n[" .. d[2] .. " | " .. fmtChance(d[4]) .. "%]", d[5], 0, g

	m.Parent = folder

	-- Оповещение всех игроков о заспавнившемся горном цветке
	rareEvent:FireAllClients(d[1], d[2], d[4])
end

local function spawnFlower()
	local roll, total, d = R:NextInteger(1, 10000), 0, F[1]
	for _, v in ipairs(F) do
		total += v[4]
		if roll <= total then d = v break end
	end

	local p = ringPoint(3) + Vector3.new(0, TOP + 0.01, 0)
	local m = Instance.new("Model")
	m.Name = d[1]

	local c = mk(m, Vector3.new(0.6, 0.6, 0.6), CFrame.new(p + Vector3.new(0, 2.3, 0)), d[5], nil, true)
	c.Name = "Center"
	mk(m, Vector3.new(0.25, 2, 0.25), CFrame.new(p + Vector3.new(0, 1, 0)), Color3.fromRGB(40, 150, 50))
	for i = 1, 5 do
		local a = math.rad(i * 72)
		mk(m, Vector3.new(0.65, 0.3, 0.65), CFrame.new(c.Position + Vector3.new(math.cos(a) * 0.55, 0, math.sin(a) * 0.55)), d[5], nil, true)
	end

	m.PrimaryPart = c
	m:SetAttribute("Rarity", d[2])
	m:SetAttribute("PollenAmount", d[3])
	m:SetAttribute("PollenType", d[2] .. " пыльца")

	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.AlwaysOnTop, g.MaxDistance, g.Parent = UDim2.fromOffset(170, 50), Vector3.new(0, 2, 0), true, 80, c
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.TextScaled, t.Font = UDim2.fromScale(1, 1), 1, true, Enum.Font.GothamBold
	t.Text, t.TextColor3, t.TextStrokeTransparency, t.Parent = d[1] .. "\n[" .. d[2] .. "]", d[5], 0, g

	m.Parent = folder
end

print("FlowerSpawner запущен!")
while true do
	-- Если цветов меньше 75, спавним новые
	if #folder:GetChildren() < MAX then
		spawnFlower()
	end
	-- Редкие цветы на склоне горы (максимум 10 на всю карту)
	if countRare() < RARE_MAX then
		local roll = R:NextNumber(0, 100)
		-- от самого редкого к более частому
		for i = #RARE, 1, -1 do
			if roll <= RARE[i][4] then
				spawnRareFlower(RARE[i])
				break
			end
		end
	end
	-- Ждем 0.35 секунды (примерно 3 цветка в секунду)
	task.wait(0.35)
end]]></ProtectedString>
				<bool name="Disabled">false</bool>

				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local BeeData = require(RS:WaitForChild("BeeData"))
local openEvent = RS:WaitForChild("OpenIvanShop")
local buyFn = RS:WaitForChild("BuyBee")
local sellFn = RS:WaitForChild("SellHoney")
local buyUpgFn = RS:WaitForChild("BuyUpgrade")

local player = Players.LocalPlayer
local coins = player:WaitForChild("leaderstats"):WaitForChild("Монеты")
local beesF = player:WaitForChild("Bees")
local honeyF = player:WaitForChild("Honey")
local upgF = player:WaitForChild("Upgrades")

local WHITE = Color3.new(1, 1, 1)
local C = {
	dark = Color3.fromRGB(14, 32, 76), mid = Color3.fromRGB(26, 62, 140),
	btn = Color3.fromRGB(46, 112, 220), hover = Color3.fromRGB(74, 146, 245),
	line = Color3.fromRGB(130, 190, 255), text = Color3.fromRGB(235, 244, 255),
	sub = Color3.fromRGB(150, 185, 235), gold = Color3.fromRGB(255, 214, 90),
	ok = Color3.fromRGB(130, 235, 160), bad = Color3.fromRGB(255, 130, 130),
}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = r}, o) end
local function outline(o, color, th, tr)
	new("UIStroke", {Color = color, Thickness = th, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end
local function label(parent, str, size, pos, ts, color, font, anchor)
	return new("TextLabel", {
		Text = str, Size = size, Position = pos, AnchorPoint = anchor or Vector2.zero,
		BackgroundTransparency = 1, TextSize = ts, TextColor3 = color,
		Font = font or Enum.Font.GothamBold, TextWrapped = true,
	}, parent)
end
local function button(parent, str, size, pos, ts, anchor, radius)
	local b = new("TextButton", {
		Text = str, Size = size, Position = pos, AnchorPoint = anchor or Vector2.zero,
		BackgroundColor3 = C.btn, TextColor3 = C.text, TextSize = ts,
		Font = Enum.Font.GothamBold, AutoButtonColor = false,
	}, parent)
	round(b, radius or UDim.new(0, 12))
	outline(b, C.line, 1.5, 0.4)
	b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = C.hover}):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = C.btn}):Play() end)
	return b
end
local function fmt(n)
	local s = tostring(n):reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (s:gsub("^ ", ""))
end

local gui = new("ScreenGui", {Name = "IvanShop", ResetOnSpawn = false, Enabled = false, DisplayOrder = 20}, player:WaitForChild("PlayerGui"))
local scales = {}

local function window(w, h, title)
	local f = new("Frame", {
		Size = UDim2.fromOffset(w, h), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, Visible = false,
	}, gui)
	round(f, UDim.new(0, 24))
	outline(f, C.line, 2.5, 0.15)
	new("UIGradient", {Color = ColorSequence.new(C.mid, C.dark), Rotation = 90}, f)
	scales[#scales + 1] = new("UIScale", {}, f)
	label(f, title, UDim2.new(1, -140, 0, 36), UDim2.new(0.5, 0, 0, 14), 26, C.text, nil, Vector2.new(0.5, 0))
	local x = button(f, "X", UDim2.fromOffset(36, 36), UDim2.new(1, -14, 0, 14), 18, Vector2.new(1, 0))
	x.MouseButton1Click:Connect(function() gui.Enabled = false end)
	return f
end

local cam = workspace.CurrentCamera
local function fit()
	local s = math.clamp(cam.ViewportSize.Y / 700, 0.55, 1.15)
	for _, u in ipairs(scales) do u.Scale = s end
end

-- ГЛАВНОЕ МЕНЮ
local main = window(400, 430, "Пчеловод Иван")
label(main, "Чем могу помочь?", UDim2.new(1, -40, 0, 22), UDim2.new(0.5, 0, 0, 56), 16, C.sub, Enum.Font.GothamMedium, Vector2.new(0.5, 0))
local status = label(main, "", UDim2.new(1, -50, 0, 60), UDim2.new(0.5, 0, 0, 352), 15, C.gold, Enum.Font.GothamMedium, Vector2.new(0.5, 0))

local btns = {}
for i, n in ipairs({"Купить пчёл", "Продать мёд", "Улучшения", "Поговорить"}) do
	btns[i] = button(main, n, UDim2.fromOffset(320, 52), UDim2.new(0.5, 0, 0, 96 + (i - 1) * 64), 20, Vector2.new(0.5, 0))
end

local lines = {
	"Привет! Я Иван, местный пчеловод.",
	"Чем реже пчела, тем ярче она светится!",
	"Цветы за пасеками полны пыльцы. Пчёлы её обожают.",
	"Говорят, у редких пчел есть шанс создать мутировавший мед!",
}
local li = 0
btns[3].MouseButton1Click:Connect(function() msgUpg.Text = "" refreshUpg() show(upg) end)
btns[4].MouseButton1Click:Connect(function()
	li = li % #lines + 1
	status.Text = "Иван: «" .. lines[li] .. "»"
end)

-- МАГАЗИН ПЧЁЛ
local shop = window(560, 500, "Магазин пчёл")
local back = button(shop, "Назад", UDim2.fromOffset(90, 36), UDim2.fromOffset(14, 14), 16)
local coinsL = label(shop, "", UDim2.new(1, -40, 0, 24), UDim2.new(0.5, 0, 0, 54), 18, C.gold, nil, Vector2.new(0.5, 0))

local art = new("Frame", {Size = UDim2.fromOffset(200, 230), Position = UDim2.new(0.5, 0, 0, 84), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1}, shop)
local glow = new("Frame", {Size = UDim2.fromOffset(230, 230), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE}, art)
round(glow, UDim.new(0.5, 0))
local jar = new("Frame", {Size = UDim2.fromOffset(156, 192), Position = UDim2.new(0.5, 0, 0, 24), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.4}, art)
round(jar, UDim.new(0, 34))
outline(jar, WHITE, 3, 0.5)
local shine = new("Frame", {Size = UDim2.fromOffset(9, 110), Position = UDim2.fromOffset(16, 28), BackgroundColor3 = WHITE, BackgroundTransparency = 0.6}, jar)
round(shine, UDim.new(0, 5))
local lid = new("Frame", {Size = UDim2.fromOffset(110, 24), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(135, 92, 55)}, art)
round(lid, UDim.new(0, 8))

local beeBox = new("Frame", {Size = UDim2.fromOffset(90, 70), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1}, jar)
local function piece(x, y, w, h, rot, radius, transp)
	local f = new("Frame", {Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), Rotation = rot or 0, BackgroundColor3 = WHITE, BackgroundTransparency = transp or 0, BorderSizePixel = 0}, beeBox)
	round(f, radius or UDim.new(0.5, 0))
	return f
end
piece(14, 0, 34, 24, -25, nil, 0.35)
piece(42, 0, 34, 24, 25, nil, 0.35)
local bodyF = piece(14, 20, 66, 46)
local marks = { piece(38, 26, 9, 34, 0, UDim.new(0, 4)), piece(54, 26, 9, 34, 0, UDim.new(0, 4)), piece(0, 31, 24, 24) }
piece(6, 37, 6, 6).BackgroundColor3 = WHITE

local left = button(shop, "<", UDim2.fromOffset(60, 60), UDim2.new(0, 34, 0, 199), 34, Vector2.new(0, 0.5), UDim.new(0.5, 0))
local right = button(shop, ">", UDim2.fromOffset(60, 60), UDim2.new(1, -34, 0, 199), 34, Vector2.new(1, 0.5), UDim.new(0.5, 0))

local nameL = label(shop, "", UDim2.new(1, -40, 0, 32), UDim2.new(0.5, 0, 0, 318), 26, C.text, nil, Vector2.new(0.5, 0))
local rarL = label(shop, "", UDim2.new(1, -40, 0, 22), UDim2.new(0.5, 0, 0, 350), 16, C.sub, Enum.Font.GothamMedium, Vector2.new(0.5, 0))
local info = label(shop, "", UDim2.new(1, -40, 0, 24), UDim2.new(0.5, 0, 0, 374), 18, C.gold, nil, Vector2.new(0.5, 0))
local buy = button(shop, "Купить", UDim2.fromOffset(220, 44), UDim2.new(0.5, 0, 0, 404), 22, Vector2.new(0.5, 0))
local msg = label(shop, "", UDim2.new(1, -40, 0, 24), UDim2.new(0.5, 0, 0, 456), 16, C.ok, Enum.Font.GothamMedium, Vector2.new(0.5, 0))

local index = 1
local function paint(color, textColor)
	local lum = color.R * 0.3 + color.G * 0.59 + color.B * 0.11
	local mark = lum > 0.3 and Color3.fromRGB(30, 25, 20) or Color3.fromRGB(255, 215, 90)
	glow.BackgroundColor3 = color
	jar.BackgroundColor3 = color:Lerp(WHITE, 0.7)
	bodyF.BackgroundColor3 = color
	for _, m in ipairs(marks) do m.BackgroundColor3 = mark end
	nameL.TextColor3 = textColor or color:Lerp(WHITE, 0.25)
end
local function refresh()
	local bee = BeeData[index]
	local owned = beesF:FindFirstChild(bee.name)
	nameL.Text = bee.name .. " пчела"
	rarL.Text = "Редкость " .. index .. " | Шанс мутации: " .. bee.mutationChance .. "%"
	info.Text = "Цена: " .. fmt(bee.price) .. "   |   У вас: " .. (owned and owned.Value or 0)
	info.TextColor3 = coins.Value >= bee.price and C.gold or C.bad
	coinsL.Text = "Монеты: " .. fmt(coins.Value)
	glow.BackgroundTransparency = index >= 12 and 0.65 or 0.88
	paint(bee.color, bee.text)
end
RunService.Heartbeat:Connect(function()
	if not shop.Visible then return end
	local t = os.clock()
	beeBox.Position = UDim2.new(0.5, 0, 0.5, math.sin(t * 2.5) * 5)
	if BeeData[index].rainbow then paint(Color3.fromHSV((t * 0.3) % 1, 0.9, 1)) end
end)

-- МЕНЮ ПРОДАЖИ МЁДА
local sell = window(500, 500, "Продажа мёда")
local backSell = button(sell, "Назад", UDim2.fromOffset(90, 36), UDim2.fromOffset(14, 14), 16)
local coinsSellL = label(sell, "", UDim2.new(1, -40, 0, 24), UDim2.new(0.5, 0, 0, 54), 18, C.gold, nil, Vector2.new(0.5, 0))

local scroll = new("ScrollingFrame", {
	Size = UDim2.new(1, -40, 0, 300), Position = UDim2.new(0.5, 0, 0, 90), AnchorPoint = Vector2.new(0.5, 0),
	BackgroundTransparency = 1, ScrollBarThickness = 6, ScrollBarImageColor3 = C.line, CanvasSize = UDim2.new(0, 0, 0, 0)
}, sell)
new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, scroll)

local msgSell = label(sell, "", UDim2.new(1, -40, 0, 36), UDim2.new(0.5, 0, 1, -50), 16, C.ok, Enum.Font.GothamMedium, Vector2.new(0.5, 0))
local sellAllBtn = button(sell, "Продать ВСЁ", UDim2.fromOffset(200, 44), UDim2.new(0.5, 0, 1, -100), 18, Vector2.new(0.5, 0))

local HONEY_PRICES = {
	["Обычный"] = 30, ["Необычный"] = 75, ["Редкий"] = 200,
	["Эпический"] = 600, ["Легендарный"] = 1500, ["Мифический"] = 4000,
	["Божественный"] = 10000, ["Небесный"] = 25000, ["Космический"] = 60000,
	["Трансцендентный"] = 150000,
	["Алмазный"] = 1000000, ["Плазменный"] = 10000000,
	["Галактический"] = 1000000000, ["Астральный"] = 10000000000,
	["Вечный"] = 100000000000,
}

local function refreshSell()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	coinsSellL.Text = "Монеты: " .. fmt(coins.Value)

	for _, item in ipairs(honeyF:GetChildren()) do
		if item:IsA("IntValue") and item.Value > 0 then
			local honeyName = item.Name

			-- Вытаскиваем множитель из названия (например, [1.35])
			local multiplierMatch = honeyName:match("%[(.-)%]")
			local multiplier = multiplierMatch and tonumber(multiplierMatch) or 1.0

			-- Красивое имя без скобок
			local displayName = honeyName:gsub("%[.-%]", ""):gsub("%s+$", "")

			-- Ищем базовую редкость
			local baseRarity = displayName:match("^(.-) %(") or displayName
			local basePrice = HONEY_PRICES[baseRarity] or 10
			local finalPrice = math.floor(basePrice * multiplier)

			local isMut = string.find(displayName, "мутация") ~= nil

			local row = new("Frame", {Size = UDim2.new(1, -10, 0, 50), BackgroundColor3 = Color3.fromRGB(30, 45, 80)}, scroll)
			round(row, UDim.new(0, 8))

			label(row, displayName, UDim2.new(0.65, 0, 1, 0), UDim2.fromOffset(10, 0), 15, isMut and C.gold or C.text, Enum.Font.GothamMedium, Vector2.new(0, 0.5))
			label(row, "x" .. item.Value .. " (по " .. finalPrice .. ")", UDim2.new(0.35, 0, 1, 0), UDim2.fromOffset(220, 0), 14, C.sub, Enum.Font.GothamMedium, Vector2.new(0, 0.5))

			local function sellAmount(amount)
				if amount <= 0 or amount > item.Value then return end
				local ok, success, message = pcall(sellFn.InvokeServer, sellFn, honeyName, amount)
				if not ok then success, message = false, "Ошибка" end
				msgSell.Text = message
				msgSell.TextColor3 = success and C.ok or C.bad
				refreshSell()
			end

			local btn1 = button(row, "1", UDim2.fromOffset(30, 30), UDim2.new(1, -140, 0.5, 0), 14, Vector2.new(0, 0.5))
			btn1.MouseButton1Click:Connect(function() sellAmount(1) end)
			local btn10 = button(row, "10", UDim2.fromOffset(30, 30), UDim2.new(1, -100, 0.5, 0), 14, Vector2.new(0, 0.5))
			btn10.MouseButton1Click:Connect(function() sellAmount(10) end)
			local btnAll = button(row, "Все", UDim2.fromOffset(40, 30), UDim2.new(1, -60, 0.5, 0), 14, Vector2.new(0, 0.5))
			btnAll.MouseButton1Click:Connect(function() sellAmount(item.Value) end)
		end
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, #scroll:GetChildren() * 58)
end

sellAllBtn.MouseButton1Click:Connect(function()
	local soldSomething = false
	for _, item in ipairs(honeyF:GetChildren()) do
		if item:IsA("IntValue") and item.Value > 0 then
			local ok, success = pcall(sellFn.InvokeServer, sellFn, item.Name, item.Value)
			if ok and success then soldSomething = true end
		end
	end
	refreshSell()
	if soldSomething then
		msgSell.Text = "Весь мёд продан!"
		msgSell.TextColor3 = C.ok
	else
		msgSell.Text = "Нечего продавать (или ошибка)"
		msgSell.TextColor3 = C.bad
	end
end)

-- ОКНО УЛУЧШЕНИЙ
local upg = window(520, 480, "Улучшения")
local backUpg = button(upg, "Назад", UDim2.fromOffset(90, 36), UDim2.fromOffset(14, 14), 16)
local coinsUpgL = label(upg, "", UDim2.new(1, -40, 0, 24), UDim2.new(0.5, 0, 0, 54), 18, C.gold, nil, Vector2.new(0.5, 0))

local UPGRADES = {
	{ id = "SpeedLevel", name = "Скорость пчёл", base = 10000, growth = 1.6, max = 25, desc = "+5% к скорости полёта за уровень" },
	{ id = "TimeLevel", name = "Скорость переработки", base = 25000, growth = 1.6, max = 25, desc = "-4% времени на мёд за уровень" },
	{ id = "PriceLevel", name = "Цена мёда", base = 50000, growth = 1.6, max = 25, desc = "+7% к цене любого мёда за уровень" },
	{ id = "MutationLevel", name = "Шанс мутации", base = 100000, growth = 1.6, max = 25, desc = "+3% к шансу мутации за уровень" },
}

local upgScroll = new("ScrollingFrame", {
	Size = UDim2.new(1, -40, 0, 300), Position = UDim2.new(0.5, 0, 0, 90), AnchorPoint = Vector2.new(0.5, 0),
	BackgroundTransparency = 1, ScrollBarThickness = 6, ScrollBarImageColor3 = C.line, CanvasSize = UDim2.new(0, 0, 0, 0)
}, upg)
new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, upgScroll)

local msgUpg = label(upg, "", UDim2.new(1, -40, 0, 36), UDim2.new(0.5, 0, 1, -50), 16, C.ok, Enum.Font.GothamMedium, Vector2.new(0.5, 0))

local upgBusy = false
local function refreshUpg()
	for _, child in ipairs(upgScroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	coinsUpgL.Text = "Монеты: " .. fmt(coins.Value)

	for _, u in ipairs(UPGRADES) do
		local lvlVal = upgF:FindFirstChild(u.id)
		local level = lvlVal and lvlVal.Value or 0
		local maxed = level >= u.max
		local cost = math.floor(u.base * u.growth ^ level)

		local row = new("Frame", {Size = UDim2.new(1, -10, 0, 64), BackgroundColor3 = Color3.fromRGB(30, 45, 80)}, upgScroll)
		round(row, UDim.new(0, 8))

		label(row, u.name, UDim2.new(0.55, 0, 0, 22), UDim2.fromOffset(12, 7), 16, C.text)
		label(row, u.desc .. "  |  Ур. " .. level .. "/" .. u.max, UDim2.new(0.55, 0, 0, 16), UDim2.fromOffset(12, 32), 13, C.sub, Enum.Font.GothamMedium)

		local buyBtn
		if maxed then
			buyBtn = button(row, "МАКС", UDim2.fromOffset(100, 36), UDim2.new(1, -112, 0.5, 0), 15, Vector2.new(1, 0.5))
			buyBtn.BackgroundColor3 = Color3.fromRGB(90, 100, 120)
		else
			buyBtn = button(row, fmt(cost) .. " монет", UDim2.fromOffset(100, 36), UDim2.new(1, -112, 0.5, 0), 13, Vector2.new(1, 0.5))
			if coins.Value < cost then
				buyBtn.BackgroundColor3 = Color3.fromRGB(150, 70, 70)
			end
			buyBtn.MouseButton1Click:Connect(function()
				if upgBusy then return end
				upgBusy = true
				local ok, success, message = pcall(buyUpgFn.InvokeServer, buyUpgFn, u.id)
				if not ok then success, message = false, "Ошибка связи" end
				msgUpg.Text = message or ""
				msgUpg.TextColor3 = success and C.ok or C.bad
				refreshUpg()
				upgBusy = false
			end)
		end
	end
end

-- УПРАВЛЕНИЕ
local function show(w)
	main.Visible = (w == main)
	shop.Visible = (w == shop)
	sell.Visible = (w == sell)
	upg.Visible = (w == upg)
	gui.Enabled = true
end

openEvent.OnClientEvent:Connect(function()
	status.Text = ""
	show(main)
end)
btns[1].MouseButton1Click:Connect(function() msg.Text = "" refresh() show(shop) end)
btns[2].MouseButton1Click:Connect(function() msgSell.Text = "" refreshSell() show(sell) end)
back.MouseButton1Click:Connect(function() show(main) end)
backSell.MouseButton1Click:Connect(function() show(main) end)
backUpg.MouseButton1Click:Connect(function() show(main) end)
left.MouseButton1Click:Connect(function() index = (index - 2) % #BeeData + 1 msg.Text = "" refresh() end)
right.MouseButton1Click:Connect(function() index = index % #BeeData + 1 msg.Text = "" refresh() end)
coins.Changed:Connect(refresh)
coins.Changed:Connect(refreshSell)
coins.Changed:Connect(function() if upg.Visible then refreshUpg() end end)
for _, v in ipairs(upgF:GetChildren()) do
	if v:IsA("IntValue") then
		v.Changed:Connect(function() if upg.Visible then refreshUpg() end end)
	end
end

local busy = false
buy.MouseButton1Click:Connect(function()
	if busy then return end
	busy = true
	local ok, success, message = pcall(buyFn.InvokeServer, buyFn, index)
	if not ok then success, message = false, "Ошибка связи" end
	refresh()
	msg.Text = message or ""
	msg.TextColor3 = success and C.ok or C.bad
	busy = false
end)

fit()
cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)]]></ProtectedString>

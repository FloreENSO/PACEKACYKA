			</Item>
			<Item class="LocalScript" referent="RBX282F185789A14F56B776274A2DBCECE4">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local plr = Players.LocalPlayer
local pg = plr:WaitForChild("PlayerGui")

local rareEvent = RS:WaitForChild("RareFlowerSpawned")

-- Цвета редкостей
local RARITY_COLORS = {
	["Алмазный"] = Color3.fromRGB(170, 220, 255),
	["Плазменный"] = Color3.fromRGB(255, 60, 200),
	["Галактический"] = Color3.fromRGB(130, 60, 255),
	["Астральный"] = Color3.fromRGB(0, 255, 220),
	["Вечный"] = Color3.fromRGB(255, 215, 0),
}

local function fmtChance(x)
	if x >= 1 then return tostring(x)
	elseif x >= 0.1 then return string.format("%.1f", x)
	else
		local s = string.format("%.6f", x)
		s = s:gsub("0+$", ""):gsub("%.$", "")
		return s
	end
end

local function show(name, rarity, chance)
	local color = RARITY_COLORS[rarity] or Color3.fromRGB(255, 215, 0)

	-- Контейнер баннера
	local banner = Instance.new("Frame")
	banner.Name = "RareFlowerBanner"
	banner.Size = UDim2.fromOffset(520, 110)
	banner.Position = UDim2.new(0.5, 0, 0, -130) -- начинаем за экраном сверху
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
	banner.BackgroundTransparency = 0.15
	banner.BorderSizePixel = 0
	banner.ZIndex = 50

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = banner

	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 3
	stroke.Parent = banner

	-- Заголовок
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -30, 0, 45)
	title.Position = UDim2.new(0, 15, 0, 10)
	title.BackgroundTransparency = 1
	title.Text = "\u{2745} Заспавнился горный цветок! \u{2745}"
	title.TextScaled = true
	title.Font = Enum.Font.GothamBold
	title.TextColor3 = color
	title.TextStrokeTransparency = 0.6
	title.Parent = banner

	-- Подпись: редкость и шанс
	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.new(1, -30, 0, 40)
	sub.Position = UDim2.new(0, 15, 0, 55)
	sub.BackgroundTransparency = 1
	sub.Text = name .. "  |  Редкость: " .. rarity .. "  |  Шанс: " .. fmtChance(chance) .. "%"
	sub.TextScaled = true
	sub.Font = Enum.Font.GothamMedium
	sub.TextColor3 = Color3.fromRGB(240, 240, 240)
	sub.TextStrokeTransparency = 0.8
	sub.Parent = banner

	banner.Parent = pg

	-- Появление сверху
	local showTween = TweenService:Create(banner, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{Position = UDim2.new(0.5, 0, 0, 20)})
	showTween:Play()

	-- Через 6 секунд — уход вверх и удаление
	task.delay(6, function()
		if not banner.Parent then return end
		local hideTween = TweenService:Create(banner, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{Position = UDim2.new(0.5, 0, 0, -130), BackgroundTransparency = 1})
		hideTween:Play()
		hideTween.Completed:Wait()
		banner:Destroy()
	end)
end

rareEvent.OnClientEvent:Connect(function(name, rarity, chance)
	show(name, rarity, chance)
end)]]></ProtectedString>

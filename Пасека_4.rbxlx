			<Item class="LocalScript" referent="RBX8EE24239C09C445FA64563929EDD3FDE">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local plr = Players.LocalPlayer

-- ================== ПАНЕЛЬ ЗАДАНИЯ ==================
local gui = Instance.new("ScreenGui")
gui.Name = "TutorialUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = plr:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.AnchorPoint = Vector2.new(0.5, 0)
frame.Position = UDim2.new(0.5, 0, 0, 10)
frame.Size = UDim2.fromOffset(480, 66)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
frame.BackgroundTransparency = 0.2
frame.BorderSizePixel = 0
frame.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, -20, 0.55, 0)
label.Position = UDim2.new(0, 10, 0.08, 0)
label.BackgroundTransparency = 1
label.Font = Enum.Font.GothamBold
label.TextColor3 = Color3.fromRGB(255, 220, 90)
label.TextScaled = true
label.Text = ""
label.Parent = frame

local distLabel = Instance.new("TextLabel")
distLabel.Size = UDim2.new(1, -20, 0.3, 0)
distLabel.Position = UDim2.new(0, 10, 0.66, 0)
distLabel.BackgroundTransparency = 1
distLabel.Font = Enum.Font.Gotham
distLabel.TextColor3 = Color3.fromRGB(235, 235, 235)
distLabel.TextScaled = true
distLabel.Text = ""
distLabel.Parent = frame

-- ================== 3D-СТРЕЛКА (указывает на цель) ==================
local arrow = Instance.new("Model")
arrow.Name = "TutorialArrow"

local function mkPart(size, color)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = arrow
	return p
end

-- стрелка смотрит в -Z (как CFrame.lookAt); кончик в (0,0,0)
local shaft = mkPart(Vector3.new(0.35, 0.35, 1.4), Color3.fromRGB(255, 210, 60))
shaft.CFrame = CFrame.new(0, 0, 0.7)
arrow.PrimaryPart = shaft
-- крылья-шеврона: от кончика (0,0,0) назад-вбок
for _, side in ipairs({-1, 1}) do
	local d = Vector3.new(side * 0.707, 0, 0.707)
	local center = d * 0.55
	local wing = mkPart(Vector3.new(0.35, 0.35, 1.1), Color3.fromRGB(255, 230, 100))
	wing.CFrame = CFrame.lookAt(center, center + d)
end
arrow.Parent = nil

-- ================== МАРКЕР ЦЕЛИ ==================
local marker = Instance.new("Part")
marker.Name = "TutorialMarker"
marker.Shape = Enum.PartType.Ball
marker.Size = Vector3.new(1.6, 1.6, 1.6)
marker.Color = Color3.fromRGB(80, 255, 140)
marker.Material = Enum.Material.Neon
marker.Transparency = 0.35
marker.Anchored = true
marker.CanCollide = false
marker.CanQuery = false
marker.CanTouch = false
marker.CastShadow = false
local light = Instance.new("PointLight")
light.Color = Color3.fromRGB(80, 255, 140)
light.Range = 12
light.Brightness = 1.5
light.Parent = marker

-- ================== ОПРЕДЕЛЕНИЕ ЦЕЛИ ==================
local function getTarget(step)
	if not step or step > 5 then return nil end
	local hub = workspace:FindFirstChild("Hub")
	if step == 1 then
		local shop = hub and hub:FindFirstChild("AndreyWorkshop")
		local ct = shop and shop:FindFirstChild("CounterTop", true)
		return ct and ct.Position
	elseif step == 2 or step == 5 then
		local shop = hub and hub:FindFirstChild("BeekeeperShop")
		local ct = shop and shop:FindFirstChild("CounterTop", true)
		return ct and ct.Position
	else
		-- шаги 3 и 4: улей игрока
		local hive = workspace:FindFirstChild(plr.Name .. "_Hive_1")
		if hive then
			local pp = hive.PrimaryPart or hive:FindFirstChildWhichIsA("BasePart", true)
			if pp then return pp.Position + Vector3.new(0, 4, 0) end
		end
		-- запасной вариант: участок игрока
		local idx = plr:GetAttribute("PlotIndex")
		local plots = workspace:FindFirstChild("Plots")
		local plot = idx and plots and plots:FindFirstChild("Plot" .. idx)
		local ground = plot and plot:FindFirstChild("Ground")
		return ground and ground.Position + Vector3.new(0, 4, 0)
	end
end

-- ================== ГЛАВНЫЙ ЦИКЛ ==================
local finished = false
local finishTimerStarted = false

RunService.RenderStepped:Connect(function()
	local step = plr:GetAttribute("TutorialStep")
	local text = plr:GetAttribute("TutorialText")
	if text and text ~= "" then label.Text = text end

	-- обучение закончено
	if not step or step > 6 then
		if arrow.Parent then arrow.Parent = nil end
		if marker.Parent then marker.Parent = nil end
		return
	end

	if step == 6 then
		if arrow.Parent then arrow.Parent = nil end
		if marker.Parent then marker.Parent = nil end
		distLabel.Text = "Награда: +500 монет!"
		if not finishTimerStarted then
			finishTimerStarted = true
			task.delay(7, function()
				finished = true
				gui:Destroy()
			end)
		end
		return
	end

	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local target = getTarget(step)
	if not root or not target then
		if arrow.Parent then arrow.Parent = nil end
		if marker.Parent then marker.Parent = nil end
		distLabel.Text = ""
		return
	end

	-- стрелка над головой, покачивается и смотрит на цель
	local head = char:FindFirstChild("Head") or root
	local bob = math.sin(os.clock() * 3) * 0.3
	local basePos = head.Position + Vector3.new(0, 3.2 + bob, 0)
	local flat = Vector3.new(target.X - basePos.X, 0, target.Z - basePos.Z)
	if flat.Magnitude < 0.05 then flat = Vector3.new(0, 0, -1) else flat = flat.Unit end
	arrow:PivotTo(CFrame.lookAt(basePos, basePos + flat))
	if arrow.Parent ~= workspace then arrow.Parent = workspace end

	-- маркер над целью, пульсирует
	local pulse = 1.6 + math.sin(os.clock() * 2.5) * 0.25
	marker.Size = Vector3.new(pulse, pulse, pulse)
	marker.CFrame = CFrame.new(target + Vector3.new(0, 3 + math.sin(os.clock() * 2) * 0.4, 0)) * CFrame.Angles(0, os.clock() * 2, 0)
	if marker.Parent ~= workspace then marker.Parent = workspace end

	-- расстояние до цели
	distLabel.Text = "Расстояние: " .. math.floor((root.Position - target).Magnitude + 0.5) .. " м"
end)]]></ProtectedString>
